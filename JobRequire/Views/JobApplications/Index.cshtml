@model JobApplicationListViewModel
@{
    ViewData["Title"] = "Review Applications";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                @if (!string.IsNullOrEmpty(Model.CurrentJobTitle))
                {
                    <span>Applications for @Model.CurrentJobTitle</span>
                }
                else
                {
                    <span>All Applications</span>
                }
            </h1>
            <p class="text-secondary mb-0">@Model.TotalCount applications found</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Job Position</label>
                    <select name="jobVacancyId" class="form-select">
                        <option value="">All Positions</option>
                        @foreach (var job in Model.JobVacancies)
                        {
                            <option value="@job.Value" selected="@(Model.JobVacancyId?.ToString() == job.Value)">@job.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select name="statusFilter" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status.Value" selected="@(Model.StatusFilter == status.Value)">@status.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm" 
                           placeholder="Name, email..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input type="date" class="form-control" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input type="date" class="form-control" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-2"></i>Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Applications Table -->
    @if (Model.Applications.Any())
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Applicant</th>
                            <th>Position</th>
                            <th>Applied</th>
                            <th>Status</th>
                            <th>Documents</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.Applications)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(app.ApplicantPhoto))
                                        {
                                            <img src="@app.ApplicantPhoto" alt="@app.ApplicantName" 
                                                 class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-2" 
                                                 style="width: 40px; height: 40px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        }
                                        <div>
                                            <strong>@app.ApplicantName</strong>
                                            <br /><small class="text-secondary">@app.ApplicantEmail</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@app.JobTitle</td>
                                <td>@app.ApplyDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge @ApplicationStatusOptions.GetStatusBadgeClass(app.Status)">
                                        @app.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@app.Documents.Count files</span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@app.JobApplicationId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-jobVacancyId="@Model.JobVacancyId"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-searchTerm="@Model.SearchTerm">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageNumber="@i"
                               asp-route-jobVacancyId="@Model.JobVacancyId"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-searchTerm="@Model.SearchTerm">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-jobVacancyId="@Model.JobVacancyId"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-searchTerm="@Model.SearchTerm">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-secondary"></i>
            <h4 class="mt-3">No applications found</h4>
            <p class="text-secondary">Applications will appear here when candidates apply to your jobs</p>
        </div>
    }
</div>

