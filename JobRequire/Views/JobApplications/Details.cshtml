@model JobApplicationViewModel
@{
    ViewData["Title"] = $"Application - {Model.ApplicantName}";
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Applications</a></li>
            <li class="breadcrumb-item active">@Model.ApplicantName</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <!-- Applicant Header -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        @if (!string.IsNullOrEmpty(Model.ApplicantPhoto))
                        {
                            <img src="@Model.ApplicantPhoto" alt="@Model.ApplicantName" 
                                 class="rounded-circle me-4" style="width: 100px; height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-4" 
                                 style="width: 100px; height: 100px;">
                                <i class="bi bi-person text-primary display-4"></i>
                            </div>
                        }
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h2 class="fw-bold mb-2">@Model.ApplicantName</h2>
                                    <p class="text-secondary mb-1">
                                        <i class="bi bi-envelope me-2"></i>@Model.ApplicantEmail
                                    </p>
                                    @if (!string.IsNullOrEmpty(Model.ApplicantPhone))
                                    {
                                        <p class="text-secondary mb-0">
                                            <i class="bi bi-telephone me-2"></i>@Model.ApplicantPhone
                                        </p>
                                    }
                                </div>
                                <span class="badge @ApplicationStatusOptions.GetStatusBadgeClass(Model.Status) fs-6">
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ApplicantSummary))
                    {
                        <hr />
                        <h6>Professional Summary</h6>
                        <p class="text-secondary mb-0">@Model.ApplicantSummary</p>
                    }
                </div>
            </div>

            <!-- View Resume Card -->
            <div class="card mb-4 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-person me-2"></i>Applicant Resume
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.IsPdfResume && !string.IsNullOrEmpty(Model.ResumeFilePath))
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="mb-1">
                                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                    <strong>PDF Resume Attached</strong>
                                </p>
                                <small class="text-muted">Click the button to view or download the resume</small>
                            </div>
                            <a asp-controller="JobApplications" asp-action="ViewResume" asp-route-id="@Model.JobApplicationId" 
                               target="_blank" class="btn btn-primary btn-lg">
                                <i class="bi bi-file-earmark-pdf me-2"></i>View Resume (PDF)
                            </a>
                        </div>
                    }
                    else if (Model.IsWebsiteResume)
                    {
                        <div class="d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <p class="mb-1">
                                        <i class="bi bi-globe text-primary me-2"></i>
                                        <strong>Website Resume</strong>
                                    </p>
                                    <small class="text-muted">View the applicant's complete resume built on our platform</small>
                                </div>
                                <a asp-controller="JobApplications" asp-action="ViewResume" asp-route-id="@Model.JobApplicationId" 
                                   target="_blank" class="btn btn-primary btn-lg">
                                    <i class="bi bi-file-person me-2"></i>View Resume
                                </a>
                            </div>
                            <div class="border-top pt-3">
                                <a asp-controller="Resumes" asp-action="DownloadPdf" asp-route-jobSeekerId="@Model.JobSeekerProfileId" 
                                   class="btn btn-outline-danger">
                                    <i class="bi bi-file-pdf me-2"></i>Download Resume (PDF)
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-file-earmark-x display-6 d-block mb-2"></i>
                            <p class="mb-0">No resume attached to this application</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Experience -->
            @if (Model.Experience.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-briefcase me-2"></i>Work Experience</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var exp in Model.Experience)
                        {
                            <div class="mb-4 pb-3 border-bottom">
                                <h6 class="mb-1">@exp.JobTitle</h6>
                                <p class="text-primary mb-1">@exp.CompanyName</p>
                                <p class="text-secondary small mb-2">
                                    @exp.StartDate?.ToString("MMM yyyy") - @(exp.EndDate?.ToString("MMM yyyy") ?? "Present")
                                </p>
                                @if (!string.IsNullOrEmpty(exp.Description))
                                {
                                    <p class="mb-0">@exp.Description</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Education -->
            @if (Model.Education.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-mortarboard me-2"></i>Education</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var edu in Model.Education)
                        {
                            <div class="mb-3">
                                <h6 class="mb-1">@edu.Qualification @(!string.IsNullOrEmpty(edu.FieldOfStudy) ? $"in {edu.FieldOfStudy}" : "")</h6>
                                <p class="text-primary mb-1">@edu.SchoolName</p>
                                <p class="text-secondary small mb-0">@edu.StartYear - @edu.EndYear</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Skills -->
            @if (Model.Skills.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-stars me-2"></i>Skills</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in Model.Skills)
                            {
                                <span class="badge @ResumeOptions.GetSkillLevelBadgeClass(skill.SkillLevel) fs-6">
                                    @skill.SkillName
                                    @if (!string.IsNullOrEmpty(skill.SkillLevel))
                                    {
                                        <small>(@skill.SkillLevel)</small>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Resume Snapshot -->
            @if (!string.IsNullOrEmpty(Model.ResumeSnapshot))
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Resume Snapshot (at time of application)</h5>
                    </div>
                    <div class="card-body">
                        <pre class="bg-light p-3 rounded" style="white-space: pre-wrap; font-family: inherit;">@Model.ResumeSnapshot</pre>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <!-- Application Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Application Details</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-4">
                        <li class="mb-3">
                            <i class="bi bi-briefcase text-primary me-2"></i>
                            <strong>Position:</strong><br />
                            <span class="ms-4">@Model.JobTitle</span>
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-building text-primary me-2"></i>
                            <strong>Company:</strong><br />
                            <span class="ms-4">@Model.CompanyName</span>
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-calendar-event text-primary me-2"></i>
                            <strong>Applied:</strong><br />
                            <span class="ms-4">@Model.ApplyDate.ToString("MMMM dd, yyyy")</span>
                        </li>
                    </ul>

                    <!-- Update Status -->
                    @if (Model.Status == "Rejected")
                    {
                        <div class="alert alert-secondary mb-3">
                            <i class="bi bi-lock-fill me-2"></i>
                            <strong>Status Locked</strong>
                            <p class="mb-0 mt-2">This application has been rejected and can no longer be updated.</p>
                        </div>
                    }
                    <form asp-action="UpdateStatus" method="post" id="statusUpdateForm">
                        <input type="hidden" name="id" value="@Model.JobApplicationId" />
                        <div class="mb-3">
                            <label class="form-label">Update Status</label>
                            <select name="status" class="form-select" id="statusSelect" @(Model.Status == "Rejected" ? "disabled" : "")>
                                @foreach (var status in Model.StatusOptions)
                                {
                                    <option value="@status.Value" selected="@(Model.Status == status.Value)">@status.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason for Status Update <span class="text-danger">*</span></label>
                            <textarea name="reason" class="form-control" rows="3" @(Model.Status == "Rejected" ? "disabled" : "required")
                                      placeholder="Please provide a reason for this status change..."
                                      id="reasonTextarea"></textarea>
                            <div class="form-text">This reason will be visible to the applicant.</div>
                        </div>

                        <!-- Interview Details Form (shown when Interview status is selected) -->
                        <div id="interviewForm" class="border rounded p-3 mb-3 bg-light" style="display: none;">
                            <h6 class="mb-3"><i class="bi bi-calendar-event me-2"></i>Interview Details</h6>
                            <div class="mb-2">
                                <label class="form-label">Interview Date <span class="text-danger">*</span></label>
                                <input type="date" name="interviewDate" class="form-control" id="interviewDate" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Interview Time <span class="text-danger">*</span></label>
                                <input type="time" name="interviewTime" class="form-control" id="interviewTime" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Location / Meeting Link <span class="text-danger">*</span></label>
                                <input type="text" name="locationOrLink" class="form-control" id="locationOrLink" 
                                       placeholder="Office address or video call link" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Contact Person <span class="text-danger">*</span></label>
                                <input type="text" name="interviewContactPerson" class="form-control" id="interviewContactPerson" 
                                       placeholder="Name of interviewer or HR contact" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Contact Phone <span class="text-danger">*</span></label>
                                <input type="tel" name="interviewContactPhone" class="form-control" id="interviewContactPhone" 
                                       placeholder="Phone number" />
                            </div>
                            <div class="mb-0">
                                <label class="form-label">Additional Notes</label>
                                <textarea name="interviewNotes" class="form-control" rows="2" id="interviewNotes"
                                          placeholder="Any additional instructions for the candidate..."></textarea>
                            </div>
                        </div>

                        <!-- Offer Details Form (shown when Offered status is selected) -->
                        <div id="offerForm" class="border rounded p-3 mb-3 bg-light" style="display: none;">
                            <h6 class="mb-3"><i class="bi bi-gift me-2"></i>Offer Details</h6>
                            <div class="mb-2">
                                <label class="form-label">Job Title <span class="text-danger">*</span></label>
                                <input type="text" name="offerJobTitle" class="form-control" id="offerJobTitle" 
                                       value="@Model.JobTitle" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Salary Offered (RM) <span class="text-danger">*</span></label>
                                <input type="number" name="salaryOffered" class="form-control" id="salaryOffered" 
                                       placeholder="Monthly salary" step="0.01" min="0" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                <input type="date" name="startDate" class="form-control" id="startDate" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Employment Type <span class="text-danger">*</span></label>
                                <select name="employmentType" class="form-select" id="employmentType">
                                    <option value="">Select type...</option>
                                    <option value="Full-Time">Full-Time</option>
                                    <option value="Part-Time">Part-Time</option>
                                    <option value="Contract">Contract</option>
                                    <option value="Internship">Internship</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Contact Person <span class="text-danger">*</span></label>
                                <input type="text" name="offerContactPerson" class="form-control" id="offerContactPerson" 
                                       placeholder="HR contact name" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Contact Phone <span class="text-danger">*</span></label>
                                <input type="tel" name="offerContactPhone" class="form-control" id="offerContactPhone" 
                                       placeholder="Phone number" />
                            </div>
                            <div class="mb-0">
                                <label class="form-label">Additional Notes</label>
                                <textarea name="offerNotes" class="form-control" rows="2" id="offerNotes"
                                          placeholder="Benefits, terms, or other details..."></textarea>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100" @(Model.Status == "Rejected" ? "disabled" : "")>
                            <i class="bi bi-check-circle me-2"></i>Update Status
                        </button>
                    </form>
                </div>
            </div>

            <!-- Application Chat -->
            @{
                ViewData["JobApplicationId"] = Model.JobApplicationId;
            }
            @await Html.PartialAsync("_ApplicationChat")

            <!-- Documents -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-paperclip me-2"></i>Documents</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.AdditionalDocument))
                    {
                        <div class="mb-3">
                            <a href="@Model.AdditionalDocument" target="_blank" class="btn btn-outline-primary w-100">
                                <i class="bi bi-file-earmark-arrow-down me-2"></i>Additional Document
                            </a>
                        </div>
                    }

                    @if (Model.Documents.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var doc in Model.Documents)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div class="d-flex align-items-center flex-grow-1">
                                        <i class="@doc.FileIcon me-2 fs-5"></i>
                                        <div>
                                            <div class="fw-semibold">@doc.FileName</div>
                                            <small class="text-muted">
                                                @doc.FileSizeDisplay • @doc.UploadedAt.ToString("MMM dd, yyyy")
                                            </small>
                                        </div>
                                    </div>
                                    <a href="@doc.DownloadUrl" class="btn btn-sm btn-outline-primary" target="_blank">
                                        <i class="bi bi-download me-1"></i>Download
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else if (string.IsNullOrEmpty(Model.AdditionalDocument))
                    {
                        <p class="text-secondary mb-0">No additional documents attached</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Application Timeline Section (Read-Only for Employer) -->
    @if (Model.Timeline.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul me-2" style="color: var(--primary-color);"></i>Application Timeline
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="employer-timeline">
                            @foreach (var item in Model.Timeline)
                            {
                                <div class="employer-timeline-item">
                                    <div class="employer-timeline-marker @GetTimelineMarkerClass(item.Status)">
                                        <i class="bi @GetTimelineIcon(item)"></i>
                                    </div>
                                    <div class="employer-timeline-content">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                                            <div>
                                                <h6 class="mb-0 fw-bold">@GetTimelineEventTitle(item)</h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar3 me-1"></i>@item.EventDate.ToString("MMMM dd, yyyy 'at' h:mm tt")
                                                </small>
                                            </div>
                                            <span class="badge @ApplicationStatusOptions.GetStatusBadgeClass(item.Status) mt-1 mt-md-0">
                                                @item.Status
                                            </span>
                                        </div>

                                        @if (!string.IsNullOrEmpty(item.Reason) && item.EventType != "Applied")
                                        {
                                            <div class="bg-light rounded p-3 mb-2">
                                                <small class="text-muted d-block mb-1"><i class="bi bi-chat-left-text me-1"></i>Reason:</small>
                                                <p class="mb-0">@item.Reason</p>
                                            </div>
                                        }

                                        @* Interview Details *@
                                        @if (item.HasInterviewDetails)
                                        {
                                            <div class="border border-primary rounded p-3 mb-2 bg-white">
                                                <h6 class="text-primary mb-3"><i class="bi bi-calendar-event me-2"></i>Interview Details</h6>
                                                <div class="row g-2">
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Date</small>
                                                        <span class="fw-semibold">@item.InterviewDate?.ToString("dddd, MMMM dd, yyyy")</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Time</small>
                                                        <span class="fw-semibold">@item.InterviewTime</span>
                                                    </div>
                                                    <div class="col-12">
                                                        <small class="text-muted d-block">Location / Meeting Link</small>
                                                        <span class="fw-semibold">@item.LocationOrLink</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Contact Person</small>
                                                        <span class="fw-semibold">@item.InterviewContactPerson</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Contact Phone</small>
                                                        <span class="fw-semibold">@item.InterviewContactPhone</span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(item.InterviewNotes))
                                                    {
                                                        <div class="col-12">
                                                            <small class="text-muted d-block">Notes</small>
                                                            <span>@item.InterviewNotes</span>
                                                        </div>
                                                    }
                                                </div>
                                                @if (item.HasInterviewPdf)
                                                {
                                                    <div class="mt-3 pt-3 border-top">
                                                        <a href="@item.InterviewPdfPath" target="_blank" class="btn btn-outline-primary btn-sm">
                                                            <i class="bi bi-file-earmark-pdf me-2"></i>View Interview Letter
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @* Offer Details *@
                                        @if (item.HasOfferDetails)
                                        {
                                            <div class="border border-success rounded p-3 mb-2 bg-white">
                                                <h6 class="text-success mb-3"><i class="bi bi-gift me-2"></i>Offer Details</h6>
                                                <div class="row g-2">
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Position</small>
                                                        <span class="fw-semibold">@item.OfferJobTitle</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Salary Offered</small>
                                                        <span class="fw-semibold text-success">RM @item.SalaryOffered?.ToString("N2")</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Start Date</small>
                                                        <span class="fw-semibold">@item.StartDate?.ToString("MMMM dd, yyyy")</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Employment Type</small>
                                                        <span class="fw-semibold">@item.EmploymentType</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Contact Person</small>
                                                        <span class="fw-semibold">@item.OfferContactPerson</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Contact Phone</small>
                                                        <span class="fw-semibold">@item.OfferContactPhone</span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(item.OfferNotes))
                                                    {
                                                        <div class="col-12">
                                                            <small class="text-muted d-block">Notes</small>
                                                            <span>@item.OfferNotes</span>
                                                        </div>
                                                    }
                                                </div>
                                                @if (item.HasOfferPdf)
                                                {
                                                    <div class="mt-3 pt-3 border-top">
                                                        <a href="@item.OfferPdfPath" target="_blank" class="btn btn-success btn-sm">
                                                            <i class="bi bi-file-earmark-pdf me-2"></i>View Offer Letter
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Employer Timeline Styles */
    .employer-timeline {
        position: relative;
        padding-left: 50px;
    }
    .employer-timeline::before {
        content: '';
        position: absolute;
        left: 18px;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(to bottom, #1e3a5f, #e9ecef);
        border-radius: 2px;
    }
    .employer-timeline-item {
        position: relative;
        padding-bottom: 30px;
    }
    .employer-timeline-item:last-child {
        padding-bottom: 0;
    }
    .employer-timeline-marker {
        position: absolute;
        left: -42px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 3px solid #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
    }
    .employer-timeline-content {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 16px;
        border-left: 4px solid #1e3a5f;
    }
    .bg-purple {
        background-color: #6f42c1 !important;
    }
</style>

@functions {
    string GetTimelineMarkerClass(string status)
    {
        return status switch
        {
            "Applied" => "bg-success",
            "Pending" => "bg-warning",
            "Reviewed" => "bg-info",
            "Shortlisted" => "bg-primary",
            "Interview" => "bg-purple",
            "Offered" => "bg-success",
            "Hired" => "bg-success",
            "Rejected" => "bg-danger",
            "Withdrawn" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    string GetTimelineIcon(ApplicationTimelineItemViewModel item)
    {
        return item.EventType switch
        {
            "Applied" => "bi-send-check",
            "Interview" => "bi-calendar-event",
            "Offer" => "bi-gift",
            _ => item.Status switch
            {
                "Pending" => "bi-hourglass-split",
                "Reviewed" => "bi-eye",
                "Shortlisted" => "bi-check-circle",
                "Hired" => "bi-trophy",
                "Rejected" => "bi-x-circle",
                "Withdrawn" => "bi-arrow-return-left",
                _ => "bi-arrow-right"
            }
        };
    }

    string GetTimelineEventTitle(ApplicationTimelineItemViewModel item)
    {
        return item.EventType switch
        {
            "Applied" => "Application Submitted",
            "Interview" => "Interview Scheduled",
            "Offer" => "Offer Extended",
            _ => $"Status Updated: {item.Status}"
        };
    }
}

@section Scripts {
<script>
    $(document).ready(function() {
        var statusSelect = $('#statusSelect');
        var interviewForm = $('#interviewForm');
        var offerForm = $('#offerForm');
        var form = $('#statusUpdateForm');

        // Function to toggle forms based on selected status
        function toggleForms() {
            var selectedStatus = statusSelect.val();
            
            // Hide all extra forms first
            interviewForm.hide();
            offerForm.hide();
            
            // Remove required from all interview/offer fields
            interviewForm.find('input, select, textarea').prop('required', false);
            offerForm.find('input, select, textarea').prop('required', false);
            
            if (selectedStatus === 'Interview') {
                interviewForm.show();
                // Set required for interview fields
                $('#interviewDate').prop('required', true);
                $('#interviewTime').prop('required', true);
                $('#locationOrLink').prop('required', true);
                $('#interviewContactPerson').prop('required', true);
                $('#interviewContactPhone').prop('required', true);
            } else if (selectedStatus === 'Offered') {
                offerForm.show();
                // Set required for offer fields
                $('#offerJobTitle').prop('required', true);
                $('#salaryOffered').prop('required', true);
                $('#startDate').prop('required', true);
                $('#employmentType').prop('required', true);
                $('#offerContactPerson').prop('required', true);
                $('#offerContactPhone').prop('required', true);
            }
        }

        // Initial toggle on page load
        toggleForms();

        // Toggle on status change
        statusSelect.on('change', function() {
            toggleForms();
        });

        // Form validation before submit
        form.on('submit', function(e) {
            var selectedStatus = statusSelect.val();
            
            if (selectedStatus === 'Interview') {
                // Validate interview fields
                if (!$('#interviewDate').val() || !$('#interviewTime').val() || 
                    !$('#locationOrLink').val() || !$('#interviewContactPerson').val() || 
                    !$('#interviewContactPhone').val()) {
                    e.preventDefault();
                    alert('Please fill in all required interview details.');
                    return false;
                }
            } else if (selectedStatus === 'Offered') {
                // Validate offer fields
                if (!$('#offerJobTitle').val() || !$('#salaryOffered').val() || 
                    !$('#startDate').val() || !$('#employmentType').val() || 
                    !$('#offerContactPerson').val() || !$('#offerContactPhone').val()) {
                    e.preventDefault();
                    alert('Please fill in all required offer details.');
                    return false;
                }
            }
            
            return true;
        });
    });
</script>
}

