@model JobSeekerApplicationDetailsViewModel
@{
    ViewData["Title"] = $"Application Details - {Model.JobTitle}";
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="MyApplications">My Applications</a></li>
            <li class="breadcrumb-item active">Application Details</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Job & Application Header Card -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                        {
                            <img src="@Model.CompanyLogo" alt="@Model.CompanyName" 
                                 class="rounded me-4" style="width: 80px; height: 80px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center me-4" 
                                 style="width: 80px; height: 80px;">
                                <i class="bi bi-building text-primary display-6"></i>
                            </div>
                        }
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start flex-wrap">
                                <div>
                                    <h2 class="fw-bold mb-2">@Model.JobTitle</h2>
                                    <p class="text-primary mb-1 fs-5">
                                        <i class="bi bi-building me-2"></i>@Model.CompanyName
                                    </p>
                                    @if (!string.IsNullOrEmpty(Model.Location))
                                    {
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-geo-alt me-2"></i>@Model.Location
                                        </p>
                                    }
                                </div>
                                <span class="badge @ApplicationStatusOptions.GetStatusBadgeClass(Model.Status) fs-6 mt-2 mt-md-0">
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- Job Quick Info -->
                    <div class="row g-3">
                        @if (!string.IsNullOrEmpty(Model.JobType))
                        {
                            <div class="col-auto">
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-clock me-1"></i>@Model.JobType
                                </span>
                            </div>
                        }
                        @if (Model.SalaryMin.HasValue || Model.SalaryMax.HasValue)
                        {
                            <div class="col-auto">
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-cash-stack me-1"></i>@Model.SalaryDisplay
                                </span>
                            </div>
                        }
                        <div class="col-auto">
                            <span class="badge bg-light text-dark">
                                <i class="bi bi-calendar me-1"></i>Applied @Model.ApplyDate.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Description Card -->
            <div class="card mb-4 border-start border-4 @(Model.Status == "Shortlisted" || Model.Status == "Hired" || Model.Status == "Offered" ? "border-success" : Model.Status == "Rejected" ? "border-danger" : Model.Status == "Pending" ? "border-warning" : "border-primary")">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-info-circle me-2"></i>Application Status
                    </h5>
                    @if (Model.Status == "Pending")
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-hourglass-split text-warning fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">Your application is being reviewed</p>
                                <p class="text-muted mb-0">The employer is currently reviewing your application. You will be notified when there's an update.</p>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Reviewed")
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-eye text-info fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">Your application has been reviewed</p>
                                <p class="text-muted mb-0">The employer has reviewed your application and is considering next steps.</p>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Shortlisted")
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle text-success fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">Congratulations! You've been shortlisted</p>
                                <p class="text-muted mb-0">Great news! The employer is interested in your profile. Expect to hear from them soon.</p>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Interview")
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-calendar-check text-primary fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">Interview stage</p>
                                <p class="text-muted mb-0">You're in the interview process. Check your email for interview details.</p>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Offered")
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-gift text-success fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">You've received an offer!</p>
                                <p class="text-muted mb-0">Congratulations! The employer has extended an offer. Check your email for details.</p>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Hired")
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-trophy text-success fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">Congratulations! You've been hired!</p>
                                <p class="text-muted mb-0">You got the job! Welcome aboard. The employer will contact you with onboarding details.</p>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-x-circle text-danger fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">Application not selected</p>
                                <p class="text-muted mb-0">Unfortunately, your application was not selected for this position. Don't give up - keep applying!</p>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Withdrawn")
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-arrow-return-left text-secondary fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">Application withdrawn</p>
                                <p class="text-muted mb-0">You have withdrawn this application.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-question-circle text-secondary fs-3 me-3"></i>
                            <div>
                                <p class="mb-1 fw-semibold">Status: @Model.Status</p>
                                <p class="text-muted mb-0">Your application status has been updated.</p>
                            </div>
                        </div>
                    }

                    @* Display employer's reason for the status update *@
                    @if (!string.IsNullOrEmpty(Model.LatestStatusReason))
                    {
                        <hr class="my-3" />
                        <div class="bg-light rounded p-3">
                            <h6 class="mb-2">
                                <i class="bi bi-chat-left-text me-2"></i>Employer's Feedback
                            </h6>
                            <p class="mb-1">@Model.LatestStatusReason</p>
                            @if (Model.LatestStatusUpdatedAt.HasValue)
                            {
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>@Model.LatestStatusUpdatedAt.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")
                                </small>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Resume Section -->
            <div class="card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-person me-2" style="color: var(--primary-color);"></i>Submitted Resume
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.IsPdfResume && !string.IsNullOrEmpty(Model.ResumeFilePath))
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-file-earmark-pdf text-danger fs-2 me-3"></i>
                                <div>
                                    <p class="mb-0 fw-semibold">PDF Resume</p>
                                    <small class="text-muted">You submitted a PDF resume for this application</small>
                                </div>
                            </div>
                            <a asp-controller="JobApplications" asp-action="ViewResume" asp-route-id="@Model.JobApplicationId" 
                               target="_blank" class="btn btn-primary">
                                <i class="bi bi-download me-2"></i>Download Resume
                            </a>
                        </div>
                    }
                    else if (Model.IsWebsiteResume)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded mb-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-globe text-primary fs-2 me-3"></i>
                                <div>
                                    <p class="mb-0 fw-semibold">Website Resume</p>
                                    <small class="text-muted">You submitted your website resume for this application</small>
                                </div>
                            </div>
                            <a asp-controller="JobApplications" asp-action="ViewResume" asp-route-id="@Model.JobApplicationId" 
                               target="_blank" class="btn btn-outline-primary">
                                <i class="bi bi-eye me-2"></i>View Resume
                            </a>
                        </div>

                        <!-- Resume Preview -->
                        @if (Model.Experience.Any() || Model.Education.Any() || Model.Skills.Any())
                        {
                            <div class="border rounded p-3">
                                <h6 class="text-muted mb-3">Resume Preview</h6>
                                
                                @if (Model.Experience.Any())
                                {
                                    <div class="mb-3">
                                        <strong><i class="bi bi-briefcase me-1"></i> Experience</strong>
                                        <ul class="list-unstyled mt-2 mb-0">
                                            @foreach (var exp in Model.Experience.Take(2))
                                            {
                                                <li class="mb-2 ps-3 border-start border-2">
                                                    <span class="fw-semibold">@exp.JobTitle</span> at @exp.CompanyName
                                                    <br />
                                                    <small class="text-muted">
                                                        @exp.StartDate?.ToString("MMM yyyy") - @(exp.EndDate?.ToString("MMM yyyy") ?? "Present")
                                                    </small>
                                                </li>
                                            }
                                            @if (Model.Experience.Count > 2)
                                            {
                                                <li class="ps-3 text-muted"><em>+@(Model.Experience.Count - 2) more...</em></li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (Model.Education.Any())
                                {
                                    <div class="mb-3">
                                        <strong><i class="bi bi-mortarboard me-1"></i> Education</strong>
                                        <ul class="list-unstyled mt-2 mb-0">
                                            @foreach (var edu in Model.Education.Take(2))
                                            {
                                                <li class="mb-2 ps-3 border-start border-2">
                                                    <span class="fw-semibold">@edu.Qualification</span>
                                                    @if (!string.IsNullOrEmpty(edu.FieldOfStudy))
                                                    {
                                                        <span> in @edu.FieldOfStudy</span>
                                                    }
                                                    <br />
                                                    <small class="text-muted">@edu.SchoolName (@edu.StartYear - @(edu.EndYear?.ToString() ?? "Present"))</small>
                                                </li>
                                            }
                                            @if (Model.Education.Count > 2)
                                            {
                                                <li class="ps-3 text-muted"><em>+@(Model.Education.Count - 2) more...</em></li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (Model.Skills.Any())
                                {
                                    <div>
                                        <strong><i class="bi bi-stars me-1"></i> Skills</strong>
                                        <div class="mt-2 d-flex flex-wrap gap-1">
                                            @foreach (var skill in Model.Skills.Take(6))
                                            {
                                                <span class="badge bg-light text-dark border">@skill.SkillName</span>
                                            }
                                            @if (Model.Skills.Count > 6)
                                            {
                                                <span class="badge bg-secondary">+@(Model.Skills.Count - 6) more</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-file-earmark-x display-4 d-block mb-2"></i>
                            <p class="mb-0">No resume information available</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Additional Documents -->
            @if (Model.Documents.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-paperclip me-2" style="color: var(--primary-color);"></i>Additional Documents
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            @foreach (var doc in Model.Documents)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div class="d-flex align-items-center">
                                        <i class="@doc.FileIcon me-3 fs-4"></i>
                                        <div>
                                            <p class="mb-0 fw-semibold">@doc.FileName</p>
                                            <small class="text-muted">
                                                @doc.FileSizeDisplay • Uploaded @doc.UploadedAt.ToString("MMM dd, yyyy")
                                            </small>
                                        </div>
                                    </div>
                                    <a href="@doc.DownloadUrl" class="btn btn-sm btn-outline-primary" target="_blank">
                                        <i class="bi bi-download me-1"></i>Download
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions Card -->
            <div class="card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning me-2" style="color: var(--primary-color);"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@Model.JobVacancyId" 
                           class="btn btn-outline-primary">
                            <i class="bi bi-briefcase me-2"></i>View Job Posting
                        </a>
                        <a asp-action="MyApplications" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Back to My Applications
                        </a>
                    </div>
                </div>
            </div>

            <!-- Application Chat -->
            @{
                ViewData["JobApplicationId"] = Model.JobApplicationId;
            }
            @await Html.PartialAsync("_ApplicationChat")

            <!-- Application Timeline Card (Sidebar Summary) -->
            <div class="card mt-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2" style="color: var(--primary-color);"></i>Timeline Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        @foreach (var item in Model.Timeline.Take(3))
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker @GetTimelineMarkerClass(item.Status)"></div>
                                <div class="timeline-content">
                                    <p class="mb-0 fw-semibold">@GetTimelineEventTitle(item)</p>
                                    <small class="text-muted">@item.EventDate.ToString("MMM dd, yyyy 'at' h:mm tt")</small>
                                </div>
                            </div>
                        }
                    </div>
                    @if (Model.Timeline.Count > 3)
                    {
                        <div class="text-center mt-3">
                            <a href="#fullTimeline" class="text-primary small">View all @Model.Timeline.Count events</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Full Application Timeline Section -->
    @if (Model.Timeline.Any())
    {
        <div class="row mt-4" id="fullTimeline">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul me-2" style="color: var(--primary-color);"></i>Application Timeline
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="full-timeline">
                            @foreach (var item in Model.Timeline)
                            {
                                <div class="full-timeline-item">
                                    <div class="full-timeline-marker @GetTimelineMarkerClass(item.Status)">
                                        <i class="bi @GetTimelineIcon(item)"></i>
                                    </div>
                                    <div class="full-timeline-content">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                                            <div>
                                                <h6 class="mb-0 fw-bold">@GetTimelineEventTitle(item)</h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar3 me-1"></i>@item.EventDate.ToString("MMMM dd, yyyy 'at' h:mm tt")
                                                </small>
                                            </div>
                                            <span class="badge @ApplicationStatusOptions.GetStatusBadgeClass(item.Status) mt-1 mt-md-0">
                                                @item.Status
                                            </span>
                                        </div>

                                        @if (!string.IsNullOrEmpty(item.Reason) && item.EventType != "Applied")
                                        {
                                            <div class="bg-light rounded p-3 mb-2">
                                                <small class="text-muted d-block mb-1"><i class="bi bi-chat-left-text me-1"></i>Employer's Feedback:</small>
                                                <p class="mb-0">@item.Reason</p>
                                            </div>
                                        }

                                        @* Interview Details *@
                                        @if (item.HasInterviewDetails)
                                        {
                                            <div class="border border-primary rounded p-3 mb-2 bg-white">
                                                <h6 class="text-primary mb-3"><i class="bi bi-calendar-event me-2"></i>Interview Details</h6>
                                                <div class="row g-2">
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Date</small>
                                                        <span class="fw-semibold">@item.InterviewDate?.ToString("dddd, MMMM dd, yyyy")</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Time</small>
                                                        <span class="fw-semibold">@item.InterviewTime</span>
                                                    </div>
                                                    <div class="col-12">
                                                        <small class="text-muted d-block">Location / Meeting Link</small>
                                                        @if (!string.IsNullOrEmpty(item.LocationOrLink) && (item.LocationOrLink.StartsWith("http://") || item.LocationOrLink.StartsWith("https://")))
                                                        {
                                                            <a href="@item.LocationOrLink" target="_blank" class="fw-semibold text-primary">
                                                                <i class="bi bi-link-45deg me-1"></i>@item.LocationOrLink
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-semibold"><i class="bi bi-geo-alt me-1"></i>@item.LocationOrLink</span>
                                                        }
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Contact Person</small>
                                                        <span class="fw-semibold">@item.InterviewContactPerson</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Contact Phone</small>
                                                        <span class="fw-semibold">
                                                            <a href="tel:@item.InterviewContactPhone" class="text-decoration-none">
                                                                <i class="bi bi-telephone me-1"></i>@item.InterviewContactPhone
                                                            </a>
                                                        </span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(item.InterviewNotes))
                                                    {
                                                        <div class="col-12">
                                                            <small class="text-muted d-block">Additional Notes</small>
                                                            <span>@item.InterviewNotes</span>
                                                        </div>
                                                    }
                                                </div>
                                                @if (item.HasInterviewPdf)
                                                {
                                                    <div class="mt-3 pt-3 border-top">
                                                        <a href="@item.InterviewPdfPath" target="_blank" class="btn btn-outline-primary btn-sm">
                                                            <i class="bi bi-file-earmark-pdf me-2"></i>View Interview Letter
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @* Offer Details *@
                                        @if (item.HasOfferDetails)
                                        {
                                            <div class="border border-success rounded p-3 mb-2 bg-white">
                                                <h6 class="text-success mb-3"><i class="bi bi-gift me-2"></i>Offer Details</h6>
                                                <div class="row g-2">
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Position</small>
                                                        <span class="fw-semibold">@item.OfferJobTitle</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Salary Offered</small>
                                                        <span class="fw-semibold text-success">RM @item.SalaryOffered?.ToString("N2")</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Start Date</small>
                                                        <span class="fw-semibold">@item.StartDate?.ToString("MMMM dd, yyyy")</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Employment Type</small>
                                                        <span class="fw-semibold">@item.EmploymentType</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Contact Person</small>
                                                        <span class="fw-semibold">@item.OfferContactPerson</span>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <small class="text-muted d-block">Contact Phone</small>
                                                        <span class="fw-semibold">
                                                            <a href="tel:@item.OfferContactPhone" class="text-decoration-none">
                                                                <i class="bi bi-telephone me-1"></i>@item.OfferContactPhone
                                                            </a>
                                                        </span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(item.OfferNotes))
                                                    {
                                                        <div class="col-12">
                                                            <small class="text-muted d-block">Additional Notes</small>
                                                            <span>@item.OfferNotes</span>
                                                        </div>
                                                    }
                                                </div>
                                                @if (item.HasOfferPdf)
                                                {
                                                    <div class="mt-3 pt-3 border-top">
                                                        <a href="@item.OfferPdfPath" target="_blank" class="btn btn-success btn-sm">
                                                            <i class="bi bi-file-earmark-pdf me-2"></i>Download Offer Letter
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetTimelineMarkerClass(string status)
    {
        return status switch
        {
            "Applied" => "bg-success",
            "Pending" => "bg-warning",
            "Reviewed" => "bg-info",
            "Shortlisted" => "bg-primary",
            "Interview" => "bg-purple",
            "Offered" => "bg-success",
            "Hired" => "bg-success",
            "Rejected" => "bg-danger",
            "Withdrawn" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    string GetTimelineIcon(ApplicationTimelineItemViewModel item)
    {
        return item.EventType switch
        {
            "Applied" => "bi-send-check",
            "Interview" => "bi-calendar-event",
            "Offer" => "bi-gift",
            _ => item.Status switch
            {
                "Pending" => "bi-hourglass-split",
                "Reviewed" => "bi-eye",
                "Shortlisted" => "bi-check-circle",
                "Hired" => "bi-trophy",
                "Rejected" => "bi-x-circle",
                "Withdrawn" => "bi-arrow-return-left",
                _ => "bi-arrow-right"
            }
        };
    }

    string GetTimelineEventTitle(ApplicationTimelineItemViewModel item)
    {
        return item.EventType switch
        {
            "Applied" => "Application Submitted",
            "Interview" => "Interview Scheduled",
            "Offer" => "Offer Extended",
            _ => $"Status Updated: {item.Status}"
        };
    }
}

