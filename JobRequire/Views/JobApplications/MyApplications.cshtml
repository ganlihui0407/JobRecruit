@model JobApplicationListViewModel
@{
    ViewData["Title"] = "My Applications";
}

<div class="py-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="page-title mb-1">My Applications</h1>
            <p class="helper-text mb-0">Track the status of your job applications in one place</p>
        </div>
        <a asp-controller="JobVacancies" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-search me-2"></i>Find More Jobs
        </a>
    </div>

    <!-- Status Filter Card -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">
                        <i class="bi bi-funnel me-1" style="color: var(--primary-color);"></i>
                        Filter by Status
                    </label>
                    <select name="statusFilter" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status.Value" selected="@(Model.StatusFilter == status.Value)">@status.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Applications.Any())
    {
        <!-- Application Cards -->
        <div class="row g-4">
            @foreach (var app in Model.Applications)
            {
                <div class="col-md-6">
                    <div class="card h-100" style="border-left: 4px solid @(app.Status == "Shortlisted" ? "var(--success-color)" : app.Status == "Rejected" ? "var(--danger-color)" : app.Status == "Pending" ? "var(--warning-color)" : "var(--primary-color)");">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="mb-1">
                                        <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@app.JobVacancyId" 
                                           class="text-decoration-none" style="color: var(--text-primary);">
                                            @app.JobTitle
                                        </a>
                                    </h5>
                                    <p class="text-muted mb-0">
                                        <i class="bi bi-building me-1"></i>@app.CompanyName
                                    </p>
                                </div>
                                <span class="badge @ApplicationStatusOptions.GetStatusBadgeClass(app.Status)">
                                    @app.Status
                                </span>
                            </div>
                            
                            <!-- Status Description -->
                            <div class="mb-3 p-2 rounded" style="background: var(--bg-warm); font-size: 0.875rem;">
                                @if (app.Status == "Pending")
                                {
                                    <i class="bi bi-hourglass-split me-1" style="color: var(--warning-color);"></i>
                                    <span class="text-muted">Your application is being reviewed by the employer.</span>
                                }
                                else if (app.Status == "Shortlisted")
                                {
                                    <i class="bi bi-check-circle me-1" style="color: var(--success-color);"></i>
                                    <span class="text-muted">Great news! You've been shortlisted for this position.</span>
                                }
                                else if (app.Status == "Rejected")
                                {
                                    <i class="bi bi-x-circle me-1" style="color: var(--danger-color);"></i>
                                    <span class="text-muted">Unfortunately, your application was not selected.</span>
                                }
                                else if (app.Status == "Hired")
                                {
                                    <i class="bi bi-trophy me-1" style="color: var(--success-color);"></i>
                                    <span class="text-muted">Congratulations! You've been hired!</span>
                                }
                                else
                                {
                                    <i class="bi bi-info-circle me-1"></i>
                                    <span class="text-muted">Application status: @app.Status</span>
                                }
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>Applied @app.ApplyDate.ToString("MMM dd, yyyy")
                                </small>
                                <div class="d-flex gap-2">
                                    <a asp-action="MyApplicationDetails" asp-route-id="@app.JobApplicationId" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>View Details
                                    </a>
                                    @if (app.Status == "Pending")
                                    {
                                        <form asp-action="Withdraw" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@app.JobApplicationId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                    onclick="return confirm('Are you sure you want to withdraw this application?')">
                                                <i class="bi bi-x-circle me-1"></i>Withdraw
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="MyApplications" 
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-statusFilter="@Model.StatusFilter">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="MyApplications" 
                               asp-route-pageNumber="@i"
                               asp-route-statusFilter="@Model.StatusFilter">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="MyApplications" 
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-statusFilter="@Model.StatusFilter">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card">
            <div class="card-body">
                <div class="empty-state py-5">
                    <i class="bi bi-inbox"></i>
                    <h5>No applications yet</h5>
                    <p>Start applying to jobs to track your progress here.</p>
                    <a asp-controller="JobVacancies" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-search me-2"></i>Browse Jobs
                    </a>
                </div>
            </div>
        </div>
    }
</div>
