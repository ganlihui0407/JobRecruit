@model ApplyJobViewModel
@{
    ViewData["Title"] = $"Apply for {Model.JobTitle}";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Job Header Card -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                        {
                            <img src="@Model.CompanyLogo" alt="@Model.CompanyName" class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                                <i class="bi bi-building text-primary fs-4"></i>
                            </div>
                        }
                        <div>
                            <h4 class="mb-1">@Model.JobTitle</h4>
                            <p class="text-muted mb-0">
                                <i class="bi bi-building me-1"></i>@Model.CompanyName
                                @if (!string.IsNullOrEmpty(Model.Location))
                                {
                                    <span class="ms-2"><i class="bi bi-geo-alt me-1"></i>@Model.Location</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.JobType))
                                {
                                    <span class="ms-2"><i class="bi bi-clock me-1"></i>@Model.JobType</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resume Fit Hint (Informational Only) -->
            @if (Model.FitHint != null)
            {
                <div class="card mb-4 border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-lightbulb me-2 text-primary"></i>Resume Fit Hint
                        </h6>
                        
                        @if (Model.FitHint.HasWebsiteResume)
                        {
                            <div class="d-flex align-items-center mb-2">
                                <i class="@Model.FitHint.MatchLevelIcon fs-4 me-2"></i>
                                <span class="badge @Model.FitHint.MatchLevelBadgeClass fs-6">@Model.FitHint.MatchLevel</span>
                            </div>
                            
                            @if (Model.FitHint.MatchedSkills.Any())
                            {
                                <p class="text-muted small mb-2">
                                    <strong>@Model.FitHint.MatchedSkillsCount</strong> of your skills match this job:
                                    @string.Join(", ", Model.FitHint.MatchedSkills)
                                </p>
                            }
                            
                            @if (Model.FitHint.HasMissingSkills)
                            {
                                <div class="alert alert-info py-2 mb-2">
                                    <i class="bi bi-lightbulb-fill me-1"></i>
                                    <small>
                                        <strong>To improve your match, consider adding:</strong>
                                        @string.Join(", ", Model.FitHint.MissingSkills)
                                    </small>
                                </div>
                            }
                            
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Improve your resume to increase job matching quality.
                            </p>
                        }
                        else
                        {
                            <div class="alert alert-light border mb-0">
                                <p class="mb-2">
                                    <i class="bi bi-exclamation-circle text-warning me-1"></i>
                                    Resume fit analysis is unavailable because your website resume is incomplete.
                                </p>
                                <a asp-controller="Resume" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square me-1"></i>Build Website Resume
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Application Form -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-send me-2"></i>Submit Your Application
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Apply" method="post" enctype="multipart/form-data" id="applyForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="JobVacancyId" />
                        <input type="hidden" name="ResumeSource" id="ResumeSourceInput" value="@Model.ResumeSource" />

                        <!-- Resume Selection Section -->
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3">
                                <i class="bi bi-file-earmark-person me-2"></i>Choose Your Resume <span class="text-danger">*</span>
                            </h6>
                            <p class="text-muted small mb-3">Select how you want to submit your resume with this application.</p>

                            <div class="row g-3">
                                <!-- Option A: Upload PDF Resume -->
                                <div class="col-md-6">
                                    <div class="resume-option-card card h-100 @(Model.ResumeSource == "PDF" ? "border-primary selected" : "")" 
                                         id="pdfOption" onclick="selectResumeOption('PDF')">
                                        <div class="card-body text-center">
                                            <input type="radio" name="resumeRadioGroup" id="pdfRadio" 
                                                   value="PDF" class="d-none" @(Model.ResumeSource == "PDF" ? "checked" : "") />
                                            <i class="bi bi-file-earmark-pdf display-4 text-danger mb-3"></i>
                                            <h6 class="fw-bold">Upload PDF Resume</h6>
                                            <p class="text-muted small mb-3">Upload your own resume file</p>
                                            
                                            <div id="pdfUploadArea" class="@(Model.ResumeSource != "PDF" ? "d-none" : "")">
                                                <div class="file-upload-zone border rounded p-3 mb-2" id="dropZone">
                                                    <i class="bi bi-cloud-upload fs-4 text-muted d-block mb-1"></i>
                                                    <small class="text-muted">Drag & drop or click to upload</small>
                                                    <input type="file" asp-for="ResumeFile" id="resumeFileInput" 
                                                           accept=".pdf" class="d-none" />
                                                </div>
                                                <div id="selectedFile" class="small text-success d-none">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    <span id="selectedFileName"></span>
                                                </div>
                                                <small class="text-muted">PDF only, max 10MB</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Option B: Use Website Resume -->
                                <div class="col-md-6">
                                    <div class="resume-option-card card h-100 @(Model.ResumeSource == "Website" ? "border-primary selected" : "") @(!Model.WebsiteResume?.HasMinimumContent == true ? "disabled-option" : "")" 
                                         id="websiteOption" onclick="selectResumeOption('Website')">
                                        <div class="card-body text-center">
                                            <input type="radio" name="resumeRadioGroup" id="websiteRadio" 
                                                   value="Website" class="d-none" @(Model.ResumeSource == "Website" ? "checked" : "") 
                                                   @(!Model.WebsiteResume?.HasMinimumContent == true ? "disabled" : "") />
                                            <i class="bi bi-globe display-4 text-primary mb-3"></i>
                                            <h6 class="fw-bold">Use Website Resume</h6>
                                            <p class="text-muted small mb-3">Use your profile resume</p>
                                            
                                            @if (Model.WebsiteResume != null)
                                            {
                                                <div class="text-start bg-light rounded p-2 small">
                                                    @if (Model.WebsiteResume.HasMinimumContent)
                                                    {
                                                        <div class="mb-1">
                                                            <span class="badge bg-success">
                                                                <i class="bi bi-check-circle me-1"></i>Ready
                                                            </span>
                                                            <span class="ms-2">@Model.WebsiteResume.CompletionPercentage% complete</span>
                                                        </div>
                                                        <div class="text-muted">
                                                            <i class="bi bi-mortarboard me-1"></i>@Model.WebsiteResume.EducationCount education
                                                            <i class="bi bi-briefcase ms-2 me-1"></i>@Model.WebsiteResume.ExperienceCount experience
                                                            <i class="bi bi-stars ms-2 me-1"></i>@Model.WebsiteResume.SkillsCount skills
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-warning">
                                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                                            Incomplete resume
                                                        </div>
                                                        <p class="text-muted mb-1 small">@Model.WebsiteResume.ValidationMessage</p>
                                                        <a asp-controller="Resume" asp-action="Index" class="btn btn-sm btn-outline-primary mt-1">
                                                            <i class="bi bi-pencil me-1"></i>Complete Resume
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <span asp-validation-for="ResumeSource" class="text-danger small"></span>
                            <span asp-validation-for="ResumeFile" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Additional Documents Section -->
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3">
                                <i class="bi bi-paperclip me-2"></i>Additional Documents (Optional)
                            </h6>
                            <p class="text-muted small mb-2">
                                Upload supporting documents such as cover letter, certificates, portfolio, etc.
                            </p>
                            
                            <div class="file-upload-area border rounded p-4 text-center" id="additionalDocsArea">
                                <i class="bi bi-cloud-upload display-4 text-muted d-block mb-2"></i>
                                <p class="mb-2">
                                    <strong>Click to upload</strong> or drag and drop
                                </p>
                                <p class="text-muted small mb-0">
                                    PDF, DOCX, JPG, PNG (Max 10MB per file)
                                </p>
                                <input type="file" name="AdditionalDocuments" id="additionalDocsInput" 
                                       multiple accept=".pdf,.docx,.jpg,.jpeg,.png" class="d-none" />
                            </div>

                            <!-- File List -->
                            <div id="additionalFileList" class="mt-3"></div>
                        </div>

                        <!-- Cover Letter (Optional) -->
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3">
                                <i class="bi bi-chat-left-text me-2"></i>Cover Letter (Optional)
                            </h6>
                            <textarea asp-for="CoverLetter" class="form-control" rows="5" 
                                      placeholder="Tell the employer why you're a great fit for this position..."></textarea>
                            <span asp-validation-for="CoverLetter" class="text-danger small"></span>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@Model.JobVacancyId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
                                <i class="bi bi-send me-2"></i>Submit Application
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .resume-option-card {
            cursor: pointer;
            transition: all 0.2s ease;
            border: 2px solid #dee2e6;
        }
        .resume-option-card:hover:not(.disabled-option) {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
        }
        .resume-option-card.selected {
            border-color: #0d6efd;
            background-color: rgba(13, 110, 253, 0.05);
        }
        .resume-option-card.disabled-option {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .file-upload-zone {
            cursor: pointer;
            transition: all 0.2s ease;
            border-style: dashed !important;
        }
        .file-upload-zone:hover {
            background-color: #f8f9fa;
            border-color: #0d6efd !important;
        }
        .file-upload-zone.drag-over {
            background-color: #e7f1ff;
            border-color: #0d6efd !important;
        }
        .file-upload-area {
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .file-upload-area:hover {
            background-color: #f8f9fa !important;
            border-color: #0d6efd !important;
        }
        .file-item {
            transition: all 0.2s ease;
        }
        .file-item:hover {
            background-color: #e9ecef !important;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const resumeSourceInput = document.getElementById('ResumeSourceInput');
            const pdfOption = document.getElementById('pdfOption');
            const websiteOption = document.getElementById('websiteOption');
            const pdfRadio = document.getElementById('pdfRadio');
            const websiteRadio = document.getElementById('websiteRadio');
            const pdfUploadArea = document.getElementById('pdfUploadArea');
            const resumeFileInput = document.getElementById('resumeFileInput');
            const dropZone = document.getElementById('dropZone');
            const selectedFile = document.getElementById('selectedFile');
            const selectedFileName = document.getElementById('selectedFileName');
            const submitBtn = document.getElementById('submitBtn');
            const additionalDocsArea = document.getElementById('additionalDocsArea');
            const additionalDocsInput = document.getElementById('additionalDocsInput');
            const additionalFileList = document.getElementById('additionalFileList');

            const websiteResumeValid = @(Model.WebsiteResume?.HasMinimumContent == true ? "true" : "false");

            // Initialize based on current selection
            validateForm();

            // Resume option selection
            window.selectResumeOption = function(option) {
                if (option === 'Website' && !websiteResumeValid) {
                    return; // Don't allow selecting incomplete website resume
                }

                resumeSourceInput.value = option;

                // Update visual selection
                pdfOption.classList.remove('selected', 'border-primary');
                websiteOption.classList.remove('selected', 'border-primary');

                if (option === 'PDF') {
                    pdfOption.classList.add('selected', 'border-primary');
                    pdfRadio.checked = true;
                    pdfUploadArea.classList.remove('d-none');
                } else {
                    websiteOption.classList.add('selected', 'border-primary');
                    websiteRadio.checked = true;
                    pdfUploadArea.classList.add('d-none');
                }

                validateForm();
            };

            // PDF file upload handling
            dropZone.addEventListener('click', function() {
                resumeFileInput.click();
            });

            dropZone.addEventListener('dragover', function(e) {
                e.preventDefault();
                dropZone.classList.add('drag-over');
            });

            dropZone.addEventListener('dragleave', function() {
                dropZone.classList.remove('drag-over');
            });

            dropZone.addEventListener('drop', function(e) {
                e.preventDefault();
                dropZone.classList.remove('drag-over');
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    handleResumeFile(files[0]);
                }
            });

            resumeFileInput.addEventListener('change', function() {
                if (this.files.length > 0) {
                    handleResumeFile(this.files[0]);
                }
            });

            function handleResumeFile(file) {
                // Validate file type
                if (!file.name.toLowerCase().endsWith('.pdf')) {
                    showToast('Only PDF files are accepted.', 'danger');
                    return;
                }

                // Validate file size (10MB)
                if (file.size > 10 * 1024 * 1024) {
                    showToast('File size must not exceed 10MB.', 'danger');
                    return;
                }

                // Update UI
                selectedFileName.textContent = file.name + ' (' + formatFileSize(file.size) + ')';
                selectedFile.classList.remove('d-none');

                // Update file input
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                resumeFileInput.files = dataTransfer.files;

                validateForm();
            }

            // Additional documents handling
            additionalDocsArea.addEventListener('click', function() {
                additionalDocsInput.click();
            });

            additionalDocsArea.addEventListener('dragover', function(e) {
                e.preventDefault();
                additionalDocsArea.classList.add('border-primary', 'bg-light');
            });

            additionalDocsArea.addEventListener('dragleave', function() {
                additionalDocsArea.classList.remove('border-primary', 'bg-light');
            });

            additionalDocsArea.addEventListener('drop', function(e) {
                e.preventDefault();
                additionalDocsArea.classList.remove('border-primary', 'bg-light');
                const files = Array.from(e.dataTransfer.files);
                handleAdditionalFiles(files);
            });

            additionalDocsInput.addEventListener('change', function() {
                const files = Array.from(this.files);
                handleAdditionalFiles(files);
            });

            function handleAdditionalFiles(files) {
                const allowedTypes = ['.pdf', '.docx', '.jpg', '.jpeg', '.png'];
                const maxSize = 10 * 1024 * 1024;

                files.forEach(function(file) {
                    const ext = '.' + file.name.split('.').pop().toLowerCase();
                    
                    if (!allowedTypes.includes(ext)) {
                        showToast(file.name + ' is not an allowed file type.', 'danger');
                        return;
                    }

                    if (file.size > maxSize) {
                        showToast(file.name + ' exceeds the maximum file size of 10MB.', 'danger');
                        return;
                    }

                    addFileToList(file);
                });
            }

            function addFileToList(file) {
                const fileItem = document.createElement('div');
                fileItem.className = 'file-item d-flex justify-content-between align-items-center p-2 mb-2 bg-light rounded';
                fileItem.dataset.fileName = file.name;

                fileItem.innerHTML = `
                    <div class="d-flex align-items-center">
                        <i class="${getFileIcon(file.name)} me-2"></i>
                        <div>
                            <div class="fw-semibold">${file.name}</div>
                            <small class="text-muted">${formatFileSize(file.size)}</small>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger remove-file">
                        <i class="bi bi-x"></i>
                    </button>
                `;

                fileItem.querySelector('.remove-file').addEventListener('click', function() {
                    fileItem.remove();
                    updateAdditionalFilesInput();
                });

                additionalFileList.appendChild(fileItem);
                updateAdditionalFilesInput();
            }

            function updateAdditionalFilesInput() {
                // Note: This doesn't actually update the file input for multiple files
                // The files are handled by the existing file input
            }

            function validateForm() {
                const source = resumeSourceInput.value;
                let isValid = false;

                if (source === 'PDF') {
                    isValid = resumeFileInput.files.length > 0;
                } else if (source === 'Website') {
                    isValid = websiteResumeValid;
                }

                submitBtn.disabled = !isValid;
            }

            function getFileIcon(fileName) {
                const ext = fileName.split('.').pop().toLowerCase();
                switch(ext) {
                    case 'pdf': return 'bi-file-pdf text-danger';
                    case 'docx':
                    case 'doc': return 'bi-file-word text-primary';
                    case 'jpg':
                    case 'jpeg':
                    case 'png': return 'bi-file-image text-success';
                    default: return 'bi-file-earmark';
                }
            }

            function formatFileSize(bytes) {
                if (bytes < 1024) return bytes + ' B';
                if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
            }

            function showToast(message, type) {
                var toastHtml = `
                    <div class="toast align-items-center text-bg-${type} border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body">${message}</div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                `;
                
                var toastContainer = document.getElementById('toastContainer');
                if (!toastContainer) {
                    toastContainer = document.createElement('div');
                    toastContainer.id = 'toastContainer';
                    toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                    document.body.appendChild(toastContainer);
                }
                
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                var toastEl = toastContainer.lastElementChild;
                var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                toast.show();
                
                toastEl.addEventListener('hidden.bs.toast', function() {
                    toastEl.remove();
                });
            }

            // Form submission
            document.getElementById('applyForm').addEventListener('submit', function(e) {
                if (submitBtn.disabled) {
                    e.preventDefault();
                    return;
                }
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';
            });
        });
    </script>
}
