@model JobRequire.ViewModels.CompanyReviewsViewModel
@using JobRequire.Models
@{
    ViewData["Title"] = $"Reviews - {Model.CompanyName}";
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Companies" asp-action="Index"><i class="bi bi-building me-1"></i>Companies</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.EmployerProfileId">@Model.CompanyName</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Reviews</li>
        </ol>
    </nav>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Header -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                        {
                            <img src="@Model.CompanyLogo" alt="@Model.CompanyName" 
                                 class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center me-3" 
                                 style="width: 60px; height: 60px;">
                                <i class="bi bi-building text-primary fs-4"></i>
                            </div>
                        }
                        <div>
                            <h2 class="fw-bold mb-1">@Model.CompanyName Reviews</h2>
                            <div class="d-flex align-items-center">
                                @if (Model.ReviewCount > 0)
                                {
                                    <div class="text-warning me-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(Model.AverageRating))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else if (i - Model.AverageRating < 1 && i - Model.AverageRating > 0)
                                            {
                                                <i class="bi bi-star-half"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                    <span class="fw-semibold me-2">@Model.AverageRatingDisplay</span>
                                    <span class="text-muted">(@Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews"))</span>
                                }
                                else
                                {
                                    <span class="text-muted">No reviews yet</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (Model.CanSubmitReview)
                    {
                        <a asp-action="Create" asp-route-employerProfileId="@Model.EmployerProfileId" 
                           class="btn btn-primary">
                            <i class="bi bi-pencil-square me-2"></i>Write a Review
                        </a>
                    }
                    else if (Model.HasExistingReview)
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>You have already submitted a review for this company.
                        </div>
                    }
                    else if (User.Identity?.IsAuthenticated == true && User.IsInRole("JobSeeker") && !Model.IsEligibleToReview)
                    {
                        <div class="alert alert-secondary mb-0">
                            <i class="bi bi-info-circle me-2"></i>You must apply to at least one job at this company before you can write a review.
                        </div>
                    }
                </div>
            </div>

            <!-- Reviews List -->
            @if (Model.Reviews.Any())
            {
                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-chat-quote me-2 text-primary"></i>All Reviews
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="list-group-item p-4">
                                    <!-- Under Review Warning -->
                                    @if (review.IsUnderReview)
                                    {
                                        <div class="alert alert-warning py-2 px-3 mb-3">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            <small><strong>This review is under review</strong> - It has been reported and is being evaluated.</small>
                                        </div>
                                    }

                                    <div class="d-flex align-items-start">
                                        @if (!string.IsNullOrEmpty(review.ReviewerPhoto))
                                        {
                                            <img src="@review.ReviewerPhoto" alt="@review.ReviewerName" 
                                                 class="rounded-circle me-3" style="width: 48px; height: 48px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" 
                                                 style="width: 48px; height: 48px;">
                                                <i class="bi bi-person text-secondary"></i>
                                            </div>
                                        }
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="mb-0 fw-semibold">@review.ReviewerName</h6>
                                                    <div class="text-warning small">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                                        }
                                                        <span class="text-muted ms-2">@review.TimeAgo</span>
                                                    </div>
                                                </div>
                                                
                                                <!-- Employer Report Button -->
                                                @if (Model.IsCompanyOwner && review.Status == ReviewStatus.Active)
                                                {
                                                    <form asp-action="Report" asp-route-reviewId="@review.ReviewId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" 
                                                                onclick="return confirm('Are you sure you want to report this review?');">
                                                            <i class="bi bi-flag me-1"></i>Report
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                            
                                            <p class="mb-0" style="white-space: pre-line;">@review.Comment</p>

                                            <!-- JobSeeker Response Section -->
                                            @if (review.JobseekerResponded && !string.IsNullOrEmpty(review.ResponseComment))
                                            {
                                                <div class="mt-3 p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">
                                                        <i class="bi bi-reply me-1"></i>Reviewer's Response
                                                    </small>
                                                    <p class="mb-0 small" style="white-space: pre-line;">@review.ResponseComment</p>
                                                </div>
                                            }

                                            <!-- Respond Button for Original Reviewer -->
                                            @if (review.IsUnderReview && 
                                                 !review.JobseekerResponded && 
                                                 Model.CurrentJobSeekerProfileId == review.JobSeekerProfileId)
                                            {
                                                <div class="mt-3">
                                                    <a asp-action="Respond" asp-route-reviewId="@review.ReviewId" 
                                                       class="btn btn-warning btn-sm">
                                                        <i class="bi bi-reply me-1"></i>Respond to Review Report
                                                    </a>
                                                    <small class="text-muted d-block mt-1">
                                                        <i class="bi bi-clock me-1"></i>
                                                        Respond within 3 days to prevent auto-hiding.
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-chat-quote display-4 text-muted d-block mb-3"></i>
                        <h5 class="text-muted">No reviews yet</h5>
                        <p class="text-secondary mb-0">Be the first to share your experience with this company!</p>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Rating Summary -->
            @if (Model.ReviewCount > 0)
            {
                <div class="card mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-bar-chart me-2 text-primary"></i>Rating Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <div class="display-4 fw-bold text-primary">@Model.AverageRatingDisplay</div>
                            <div class="text-warning mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor(Model.AverageRating))
                                    {
                                        <i class="bi bi-star-fill fs-5"></i>
                                    }
                                    else if (i - Model.AverageRating < 1 && i - Model.AverageRating > 0)
                                    {
                                        <i class="bi bi-star-half fs-5"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star fs-5"></i>
                                    }
                                }
                            </div>
                            <small class="text-muted">Based on @Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews")</small>
                        </div>

                        @{
                            var distribution = Model.GetRatingDistribution();
                            var maxCount = distribution.Values.Max();
                        }
                        @for (int rating = 5; rating >= 1; rating--)
                        {
                            var count = distribution[rating];
                            var percentage = maxCount > 0 ? (count * 100.0 / Model.ReviewCount) : 0;
                            <div class="d-flex align-items-center mb-2">
                                <span class="me-2" style="width: 20px;">@rating</span>
                                <i class="bi bi-star-fill text-warning me-2"></i>
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-warning" role="progressbar" 
                                         style="width: @percentage%;" aria-valuenow="@percentage" 
                                         aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <span class="ms-2 text-muted small" style="width: 30px;">@count</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Back to Company -->
            <div class="card">
                <div class="card-body">
                    <a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.EmployerProfileId" 
                       class="btn btn-outline-primary w-100">
                        <i class="bi bi-arrow-left me-2"></i>Back to Company Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>



