@model List<NotificationViewModel>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var pageNumber = ViewBag.PageNumber as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 20;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-bell me-2"></i>Notifications
            </h1>
            <p class="text-muted mb-0">
                @if (unreadCount > 0)
                {
                    <span class="badge bg-danger">@unreadCount unread</span>
                }
                <span class="ms-2">@totalCount total</span>
            </p>
        </div>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-check-all me-2"></i>Mark All as Read
                </button>
            </form>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h4 class="mt-3">No notifications</h4>
                <p class="text-muted">You're all caught up! No notifications to display.</p>
            </div>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notification in Model)
            {
                // Unread: Strong colors, Read: Muted/faded
                var bgClass = notification.IsRead 
                    ? "bg-light border-secondary" 
                    : notification.Type.ToLower() switch
                    {
                        "success" => "bg-success-subtle border-success",
                        "warning" => "bg-warning-subtle border-warning",
                        "error" => "bg-danger-subtle border-danger",
                        _ => "bg-info-subtle border-info"
                    };

                var iconClass = notification.Type.ToLower() switch
                {
                    "success" => "bi-check-circle text-success",
                    "warning" => "bi-exclamation-triangle text-warning",
                    "error" => "bi-x-circle text-danger",
                    _ => "bi-info-circle text-info"
                };

                // Reduce opacity for read notifications
                var readStyle = notification.IsRead ? "opacity: 0.7;" : "";
                var iconOpacity = notification.IsRead ? "opacity: 0.5;" : "";
                var borderStyle = notification.IsRead ? "border-left: 3px solid #dee2e6 !important;" : "border-left: 3px solid currentColor;";

                <div class="list-group-item @bgClass mb-2 rounded" style="@readStyle @borderStyle">
                    <div class="d-flex align-items-start">
                        <i class="@iconClass fs-4 me-3 mt-1" style="@iconOpacity"></i>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="mb-0 @(notification.IsRead ? "" : "fw-bold")">@notification.Title</h6>
                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-primary" style="font-size: 0.65rem;">NEW</span>
                                    }
                                </div>
                                <small class="text-muted">@notification.TimeAgo</small>
                            </div>
                            @if (!string.IsNullOrEmpty(notification.Message))
                            {
                                <p class="mb-2 text-muted">@notification.Message</p>
                            }
                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                            {
                                <a asp-action="GoTo" asp-route-id="@notification.NotificationId" 
                                   class="btn btn-sm @(notification.IsRead ? "btn-outline-secondary" : "btn-outline-primary")">
                                    <i class="bi bi-arrow-right me-1"></i>@(notification.ActionText ?? "View")
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav aria-label="Notifications pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" href="?pageNumber=@(pageNumber - 1)">Previous</a>
                    </li>
                    @for (int i = Math.Max(1, pageNumber - 2); i <= Math.Min(totalPages, pageNumber + 2); i++)
                    {
                        <li class="page-item @(i == pageNumber ? "active" : "")">
                            <a class="page-link" href="?pageNumber=@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                        <a class="page-link" href="?pageNumber=@(pageNumber + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

