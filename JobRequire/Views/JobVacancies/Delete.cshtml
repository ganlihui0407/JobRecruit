@model JobVacancyViewModel
@{
    ViewData["Title"] = "Delete Job";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Delete Job</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone. All applications for this job will also be deleted.
                    </div>

                    <div class="mb-4">
                        <h5>@Model.JobTitle</h5>
                        <p class="text-secondary mb-1"><i class="bi bi-building me-2"></i>@Model.CompanyName</p>
                        <p class="text-secondary mb-1"><i class="bi bi-geo-alt me-2"></i>@Model.Location</p>
                        <p class="text-secondary mb-0">
                            <i class="bi bi-people me-2"></i>@Model.ApplicationsCount applications will be deleted
                        </p>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="JobVacancyId" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2"></i>Yes, Delete Job
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.JobVacancyId" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

