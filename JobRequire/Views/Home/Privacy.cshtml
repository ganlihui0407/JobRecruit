@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="fw-bold mb-4">Privacy Policy</h1>
            <p class="text-secondary mb-4">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
            
            <div class="card">
                <div class="card-body">
                    <h5 class="text-primary">1. Information We Collect</h5>
                    <p>
                        We collect information you provide directly to us, such as when you create an account, 
                        update your profile, apply for jobs, or contact us for support.
                    </p>
                    
                    <h5 class="text-primary mt-4">2. How We Use Your Information</h5>
                    <p>
                        We use the information we collect to provide, maintain, and improve our services, 
                        process job applications, and communicate with you.
                    </p>
                    
                    <h5 class="text-primary mt-4">3. Information Sharing</h5>
                    <p>
                        We may share your information with employers when you apply for jobs, and with 
                        service providers who assist us in operating our platform.
                    </p>
                    
                    <h5 class="text-primary mt-4">4. Data Security</h5>
                    <p>
                        We implement appropriate security measures to protect your personal information 
                        against unauthorized access, alteration, disclosure, or destruction.
                    </p>
                    
                    <h5 class="text-primary mt-4">5. Your Rights</h5>
                    <p>
                        You have the right to access, update, or delete your personal information at any time 
                        through your account settings.
                    </p>
                    
                    <h5 class="text-primary mt-4">6. Contact Us</h5>
                    <p class="mb-0">
                        If you have any questions about this Privacy Policy, please contact us at 
                        <a href="mailto:privacy@jobrecruit.com">privacy@jobrecruit.com</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

