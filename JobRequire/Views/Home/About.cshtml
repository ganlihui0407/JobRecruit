@{
    ViewData["Title"] = "About Us";
}

<div class="py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="fw-bold mb-4">About JobRecruit</h1>
            
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="text-primary mb-3">Our Mission</h4>
                    <p class="lead">
                        JobRecruit is dedicated to connecting talented professionals with 
                        exceptional career opportunities. We believe that finding the right 
                        job should be simple, efficient, and rewarding.
                    </p>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card h-100 text-center">
                        <div class="card-body">
                            <i class="bi bi-briefcase-fill display-4 text-primary mb-3"></i>
                            <h5>10,000+</h5>
                            <p class="text-secondary mb-0">Active Job Listings</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 text-center">
                        <div class="card-body">
                            <i class="bi bi-building display-4 text-primary mb-3"></i>
                            <h5>500+</h5>
                            <p class="text-secondary mb-0">Partner Companies</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 text-center">
                        <div class="card-body">
                            <i class="bi bi-people-fill display-4 text-primary mb-3"></i>
                            <h5>50,000+</h5>
                            <p class="text-secondary mb-0">Registered Users</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="text-primary mb-3">Why Choose Us?</h4>
                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Easy to Use</strong> - Simple and intuitive interface for job seekers and employers
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Quality Listings</strong> - Verified job postings from reputable companies
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Fast Matching</strong> - Advanced algorithms to match candidates with opportunities
                        </li>
                        <li class="mb-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Secure Platform</strong> - Your data is protected with industry-standard security
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

