@{
    ViewData["Title"] = "Contact Us";
}

<div class="py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="fw-bold mb-4">Contact Us</h1>
            
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-4">Get in Touch</h5>
                            <form method="post" asp-controller="Home" asp-action="Contact">
                                <div class="mb-3">
                                    <label class="form-label">Your Name</label>
                                    <input type="text" class="form-control" name="name" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Email Address</label>
                                    <input type="email" class="form-control" name="email" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Subject</label>
                                    <input type="text" class="form-control" name="subject" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Message</label>
                                    <textarea class="form-control" name="message" rows="5" required></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send me-2"></i>Send Message
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-4">Contact Information</h5>
                            <ul class="list-unstyled">
                                <li class="mb-4">
                                    <i class="bi bi-geo-alt-fill text-primary me-3 fs-4"></i>
                                    <span class="align-middle">
                                        123 Business Street<br />
                                        <span class="ms-4 ps-2">City, State 12345</span>
                                    </span>
                                </li>
                                <li class="mb-4">
                                    <i class="bi bi-telephone-fill text-primary me-3 fs-4"></i>
                                    <span class="align-middle">+1 (555) 123-4567</span>
                                </li>
                                <li class="mb-4">
                                    <i class="bi bi-envelope-fill text-primary me-3 fs-4"></i>
                                    <span class="align-middle">support@jobrecruit.com</span>
                                </li>
                                <li class="mb-4">
                                    <i class="bi bi-clock-fill text-primary me-3 fs-4"></i>
                                    <span class="align-middle">
                                        Mon - Fri: 9:00 AM - 6:00 PM<br />
                                        <span class="ms-4 ps-2">Sat - Sun: Closed</span>
                                    </span>
                                </li>
                            </ul>
                            
                            <hr class="my-4" />
                            
                            <h6 class="mb-3">Follow Us</h6>
                            <div class="d-flex gap-3">
                                <a href="#" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-facebook"></i>
                                </a>
                                <a href="#" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-twitter-x"></i>
                                </a>
                                <a href="#" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-linkedin"></i>
                                </a>
                                <a href="#" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-instagram"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

