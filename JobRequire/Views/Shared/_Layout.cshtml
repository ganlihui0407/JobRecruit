<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobRecruit</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-briefcase-fill"></i>
                JobRecruit
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" 
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Left Navigation -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Jobs" asp-action="Index">
                            <i class="bi bi-search me-1"></i>Find Jobs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Companies" asp-action="Index">
                            <i class="bi bi-building me-1"></i>Companies
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">
                            <i class="bi bi-info-circle me-1"></i>About
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">
                            <i class="bi bi-envelope me-1"></i>Contact
                        </a>
                    </li>
                </ul>
                
                <!-- Right Navigation -->
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Chat Icon - Using ViewComponent for unread count -->
                        @await Component.InvokeAsync("Chat")
                        
                        <!-- Notifications Bell - Using ViewComponent for unified display -->
                        @await Component.InvokeAsync("Notification")
                        
                        <!-- Authenticated User Menu -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" 
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                @if (User.IsInRole("Employer"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Employer" asp-action="Dashboard">
                                            <i class="bi bi-speedometer2 me-2"></i>Employer Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="JobVacancies" asp-action="Create">
                                            <i class="bi bi-plus-circle me-2"></i>Post a Job
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                @if (User.IsInRole("JobSeeker"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="JobSeekerProfiles" asp-action="Dashboard">
                                            <i class="bi bi-speedometer2 me-2"></i>My Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="JobApplications" asp-action="MyApplications">
                                            <i class="bi bi-file-earmark-text me-2"></i>My Applications
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="JobSeekerProfiles" asp-action="Bookmarks">
                                            <i class="bi bi-bookmark me-2"></i>Saved Jobs
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person me-2"></i>My Profile
                                    </a>
                                </li>
                                @if (User.IsInRole("JobSeeker"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Resume" asp-action="Index">
                                            <i class="bi bi-file-earmark-person me-2"></i>My Resume
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Settings">
                                        <i class="bi bi-gear me-2"></i>Settings
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item" style="color: var(--danger-color);">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <!-- Guest User Menu -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main">
        <div class="container">
            <!-- Alert Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-4" role="alert" data-auto-dismiss="5000">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mt-4" role="alert">
                    <i class="bi bi-info-circle me-2"></i>@TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show mt-4" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["WarningMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h5 class="mb-3">
                        <i class="bi bi-briefcase-fill me-2" style="color: var(--primary-light);"></i>JobRecruit
                    </h5>
                    <p class="mb-3" style="opacity: 0.8;">
                        Your trusted platform for finding the perfect job or the ideal candidate. 
                        Connecting employers with talented professionals since 2024.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="fs-5" style="color: rgba(255,255,255,0.7);"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="fs-5" style="color: rgba(255,255,255,0.7);"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="fs-5" style="color: rgba(255,255,255,0.7);"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="fs-5" style="color: rgba(255,255,255,0.7);"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2 mb-4 mb-lg-0">
                    <h6 class="mb-3">For Job Seekers</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" style="opacity: 0.7;">Browse Jobs</a></li>
                        <li class="mb-2"><a href="#" style="opacity: 0.7;">Companies</a></li>
                        <li class="mb-2"><a href="#" style="opacity: 0.7;">Career Advice</a></li>
                        <li><a href="#" style="opacity: 0.7;">Resume Tips</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2 mb-4 mb-lg-0">
                    <h6 class="mb-3">For Employers</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" style="opacity: 0.7;">Post a Job</a></li>
                        <li class="mb-2"><a href="#" style="opacity: 0.7;">Browse Resumes</a></li>
                        <li class="mb-2"><a href="#" style="opacity: 0.7;">Pricing</a></li>
                        <li><a href="#" style="opacity: 0.7;">Resources</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2 mb-4 mb-lg-0">
                    <h6 class="mb-3">Company</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a asp-controller="Home" asp-action="About" style="opacity: 0.7;">About Us</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Contact" style="opacity: 0.7;">Contact</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Privacy" style="opacity: 0.7;">Privacy</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" style="opacity: 0.7;">Terms</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Support</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" style="opacity: 0.7;">Help Center</a></li>
                        <li class="mb-2"><a href="#" style="opacity: 0.7;">FAQ</a></li>
                        <li><a href="#" style="opacity: 0.7;">Feedback</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255,255,255,0.1);" />
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0" style="opacity: 0.6;">&copy; @DateTime.Now.Year JobRecruit. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small style="opacity: 0.5;">Built with ASP.NET Core MVC</small>
                </div>
            </div>
        </div>
    </footer>

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    
    <!-- Bootstrap 5 JS Bundle (includes Popper) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    
    <!-- Chart.js (loaded only when needed) -->
    @await RenderSectionAsync("Charts", required: false)
    
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Toast Container for Notifications -->
    <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;"></div>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Notification Toast Script - Shows toast for new notifications -->
        <script>
            $(document).ready(function() {
                let lastCheckTime = new Date();
                let notificationPollInterval;

                // Poll for new notifications every 30 seconds (for toast notifications only)
                notificationPollInterval = setInterval(checkForNewNotifications, 30000);

                // Check for new notifications (for toasts only - initial render is server-side)
                function checkForNewNotifications() {
                    $.ajax({
                        url: '/api/notifications/unread?limit=5',
                        method: 'GET',
                        success: function(response) {
                            if (response.success && response.notifications && response.notifications.length > 0) {
                                // Update badge count dynamically
                                updateBadge(response.unreadCount);
                                
                                // Show toast for truly new notifications
                                    response.notifications.forEach(function(notification) {
                                        var notificationTime = new Date(notification.createdAt);
                                        if (notificationTime > lastCheckTime) {
                                            showNotificationToast(notification);
                                        }
                                    });
                                lastCheckTime = new Date();
                            }
                        },
                        error: function() {
                            // Silently fail
                        }
                    });
                }

                // Update badge count
                function updateBadge(count) {
                    var badge = $('.notification-dropdown').prev().find('.badge');
                    if (count > 0) {
                        if (badge.length === 0) {
                            // Badge doesn't exist, add it
                            $('.notification-dropdown').prev().append(
                                '<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">' +
                                (count > 99 ? '99+' : count) +
                                '<span class="visually-hidden">unread notifications</span></span>'
                            );
                        } else {
                            badge.text(count > 99 ? '99+' : count);
                        }
                    } else {
                        badge.remove();
                    }
                }

                // Show notification toast
                function showNotificationToast(notification) {
                    var iconClass = getNotificationIcon(notification.type);
                    var bgClass = getNotificationBgClass(notification.type);
                    
                    var toastHtml = `
                        <div class="toast align-items-center text-bg-${bgClass} border-0" role="alert">
                            <div class="d-flex">
                                <div class="toast-body">
                                    <i class="bi ${iconClass} me-2"></i>
                                    <strong>${escapeHtml(notification.title)}</strong>
                                    ${notification.message ? `<br><small>${escapeHtml(notification.message)}</small>` : ''}
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                            </div>
                        </div>
                    `;
                    
                    var toast = $(toastHtml);
                    $('#toastContainer').append(toast);
                    
                    var bsToast = new bootstrap.Toast(toast[0], { 
                        delay: 5000,
                        autohide: true
                    });
                    
                    bsToast.show();
                    
                    toast.on('hidden.bs.toast', function() {
                        $(this).remove();
                    });
                }

                // Helper functions
                function getNotificationIcon(type) {
                    var t = (type || 'info').toLowerCase();
                    return t === 'success' ? 'bi-check-circle-fill' :
                           t === 'warning' ? 'bi-exclamation-triangle-fill' :
                           t === 'error' ? 'bi-x-circle-fill' :
                           'bi-info-circle-fill';
                }

                function getNotificationBgClass(type) {
                    var t = (type || 'info').toLowerCase();
                    return t === 'success' ? 'success' :
                           t === 'warning' ? 'warning' :
                           t === 'error' ? 'danger' :
                           'primary';
                }

                function escapeHtml(text) {
                    if (!text) return '';
                    var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
                    return text.replace(/[&<>"']/g, function(m) { return map[m]; });
                }

                // Cleanup on page unload
                $(window).on('beforeunload', function() {
                    if (notificationPollInterval) {
                        clearInterval(notificationPollInterval);
                    }
                });
            });
        </script>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
