@model List<BookmarkedJobViewModel>
@{
    ViewData["Title"] = "Saved Jobs";
    var totalCount = (int)ViewBag.TotalCount;
    var pageNumber = (int)ViewBag.PageNumber;
    var pageSize = (int)ViewBag.PageSize;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="py-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="page-title mb-1">Saved Jobs</h1>
            <p class="helper-text mb-0">
                <i class="bi bi-bookmark me-1" style="color: var(--primary-color);"></i>
                <strong>@totalCount</strong> jobs saved for later
            </p>
        </div>
        <a asp-controller="JobVacancies" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-search me-2"></i>Find More Jobs
        </a>
    </div>

    @if (Model.Any())
    {
        <!-- Saved Jobs Grid -->
        <div class="row g-4">
            @foreach (var bookmark in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card job-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="flex-grow-1 me-2">
                                    <h5 class="job-title mb-1">
                                        <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@bookmark.JobVacancyId" 
                                           class="text-decoration-none">
                                            @bookmark.JobTitle
                                        </a>
                                    </h5>
                                    <p class="company-name mb-0">
                                        <i class="bi bi-building me-1"></i>@bookmark.CompanyName
                                    </p>
                                </div>
                                <span class="badge @(bookmark.Status == "Open" ? "bg-success" : "bg-secondary")">
                                    @bookmark.Status
                                </span>
                            </div>
                            
                            <div class="job-meta mb-3">
                                <span><i class="bi bi-geo-alt"></i> @bookmark.Location</span>
                                <span><i class="bi bi-clock"></i> @bookmark.JobType</span>
                            </div>
                            
                            @if (bookmark.SalaryMin.HasValue || bookmark.SalaryMax.HasValue)
                            {
                                <div class="mb-3 p-2 rounded" style="background: var(--bg-warm); font-size: 0.875rem;">
                                    <i class="bi bi-cash-stack me-1" style="color: var(--success-color);"></i>
                                    <span>RM @(bookmark.SalaryMin?.ToString("N0") ?? "—") - RM @(bookmark.SalaryMax?.ToString("N0") ?? "—")</span>
                                </div>
                            }
                            
                            <div class="d-flex justify-content-between align-items-center pt-2" style="border-top: 1px solid var(--border-light);">
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>Saved @bookmark.CreatedAt.ToString("MMM dd")
                                </small>
                                <div class="d-flex gap-1">
                                    @if (bookmark.Status == "Open")
                                    {
                                        <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@bookmark.JobVacancyId" 
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-send me-1"></i>Apply
                                        </a>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-remove-bookmark" 
                                            data-job-id="@bookmark.JobVacancyId" 
                                            data-bookmark-id="@bookmark.BookmarkedJobId"
                                            title="Remove from saved">
                                        <i class="bi bi-bookmark-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Bookmarks" asp-route-pageNumber="@(pageNumber - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == pageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Bookmarks" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Bookmarks" asp-route-pageNumber="@(pageNumber + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card">
            <div class="card-body">
                <div class="empty-state py-5">
                    <i class="bi bi-bookmark"></i>
                    <h5>No saved jobs yet</h5>
                    <p>Save jobs you're interested in to review and apply later.</p>
                    <a asp-controller="JobVacancies" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-search me-2"></i>Browse Jobs
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Remove bookmark handler
            $('.btn-remove-bookmark').on('click', function() {
                var btn = $(this);
                var jobId = btn.data('job-id');
                var card = btn.closest('.col-md-6');
                
                btn.prop('disabled', true);
                btn.find('i').removeClass('bi-bookmark-x').addClass('bi-arrow-repeat bookmark-spin');
                
                $.ajax({
                    url: '/api/jobs/bookmark',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ jobVacancyId: jobId }),
                    success: function(response) {
                        if (response.success && !response.isBookmarked) {
                            // Remove the card with animation
                            card.fadeOut(300, function() {
                                $(this).remove();
                                
                                // Update the count
                                var countEl = $('.helper-text strong');
                                var currentCount = parseInt(countEl.text()) - 1;
                                countEl.text(currentCount);
                                
                                // If no more bookmarks, show empty state
                                if (currentCount === 0) {
                                    location.reload();
                                }
                            });
                            
                            showToast('Job removed from bookmarks', 'success');
                        } else {
                            btn.prop('disabled', false);
                            btn.find('i').removeClass('bi-arrow-repeat bookmark-spin').addClass('bi-bookmark-x');
                            showToast(response.message || 'Failed to remove bookmark', 'danger');
                        }
                    },
                    error: function() {
                        btn.prop('disabled', false);
                        btn.find('i').removeClass('bi-arrow-repeat bookmark-spin').addClass('bi-bookmark-x');
                        showToast('An error occurred. Please try again.', 'danger');
                    }
                });
            });
            
            function showToast(message, type) {
                var toastHtml = `
                    <div class="toast align-items-center text-bg-${type} border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body">${message}</div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                `;
                
                var toastContainer = $('#toastContainer');
                if (toastContainer.length === 0) {
                    $('body').append('<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
                    toastContainer = $('#toastContainer');
                }
                
                var toast = $(toastHtml);
                toastContainer.append(toast);
                var bsToast = new bootstrap.Toast(toast[0], { delay: 3000 });
                bsToast.show();
                
                toast.on('hidden.bs.toast', function() {
                    $(this).remove();
                });
            }
        });
    </script>
    <style>
        .bookmark-spin {
            animation: spin 1s linear infinite;
        }
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
}
