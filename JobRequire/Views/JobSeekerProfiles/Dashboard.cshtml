@model JobSeekerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="py-4">
    <!-- Welcome Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="page-title mb-1">Welcome back, @(!string.IsNullOrWhiteSpace(Model.Profile.FullName) ? Model.Profile.FullName.Split(' ')[0] : "there")!</h1>
            <p class="helper-text mb-0">Here's an overview of your job search activity</p>
        </div>
        <a asp-controller="JobVacancies" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="bi bi-search me-2"></i>Find Jobs
        </a>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100 bg-primary text-white">
                <div class="card-body">
                    <i class="bi bi-file-earmark-text stat-icon"></i>
                    <div class="stat-value">@Model.TotalApplications</div>
                    <div class="stat-label text-white-50">Applications</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100" style="background: var(--warning-color);">
                <div class="card-body">
                    <i class="bi bi-hourglass-split stat-icon" style="color: var(--text-primary);"></i>
                    <div class="stat-value" style="color: var(--text-primary);">@Model.PendingApplications</div>
                    <div class="stat-label" style="color: rgba(44,44,44,0.7);">Pending</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100 bg-success text-white">
                <div class="card-body">
                    <i class="bi bi-check-circle stat-icon"></i>
                    <div class="stat-value">@Model.ShortlistedApplications</div>
                    <div class="stat-label text-white-50">Shortlisted</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100 bg-info text-white">
                <div class="card-body">
                    <i class="bi bi-bookmark stat-icon"></i>
                    <div class="stat-value">@Model.RecentBookmarks.Count</div>
                    <div class="stat-label text-white-50">Saved Jobs</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Profile Summary Card -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-person me-2" style="color: var(--primary-color);"></i>My Profile
                    </h5>
                    <a asp-action="Edit" asp-route-id="@Model.Profile.JobSeekerProfileId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                </div>
                <div class="card-body text-center">
                    <!-- Profile Photo -->
                    @if (!string.IsNullOrEmpty(Model.Profile.ProfilePhoto))
                    {
                        <img src="@Model.Profile.ProfilePhoto" alt="@(!string.IsNullOrWhiteSpace(Model.Profile.FullName) ? Model.Profile.FullName : "User")" 
                             class="profile-avatar mb-3" />
                    }
                    else
                    {
                        <div class="profile-avatar-placeholder mx-auto mb-3">
                            <i class="bi bi-person"></i>
                        </div>
                    }
                    
                    <h5 class="mb-1">@(!string.IsNullOrWhiteSpace(Model.Profile.FullName) ? Model.Profile.FullName : "User")</h5>
                    <p class="text-muted mb-4">@(!string.IsNullOrWhiteSpace(Model.Profile.Email) ? Model.Profile.Email : "No email")</p>
                    
                    <!-- Profile Completeness - uses shared ResumeCompletionService -->
                    <div class="mb-2 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Profile Completeness</small>
                        <small class="fw-semibold">@Model.ProfileCompletion%</small>
                    </div>
                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar @(Model.ProfileCompletion == 100 ? "bg-success" : Model.ProfileCompletion >= 60 ? "bg-primary" : "bg-warning")" 
                             style="width: @Model.ProfileCompletion%"></div>
                    </div>
                    
                    @if (Model.ProfileCompletion < 100)
                    {
                        <div class="alert alert-info text-start mb-0" style="font-size: 0.875rem;">
                            <i class="bi bi-lightbulb me-1"></i>
                            <strong>Tip:</strong> Complete your profile to increase visibility to employers.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success text-start mb-0" style="font-size: 0.875rem;">
                            <i class="bi bi-check-circle me-1"></i>
                            Your profile is complete!
                        </div>
                    }
                </div>

                <!-- Share Profile Section -->
                @if (!string.IsNullOrEmpty(Model.PublicProfileUrl))
                {
                    <div class="card-footer bg-light">
                        <div class="share-profile-section">
                            <h6 class="mb-3">
                                <i class="bi bi-share me-2" style="color: var(--primary-color);"></i>Share Your Profile
                            </h6>
                            
                            <!-- Public URL -->
                            <div class="input-group input-group-sm mb-3">
                                <input type="text" class="form-control" id="publicProfileUrl" 
                                       value="@Model.PublicProfileUrl" readonly 
                                       style="font-size: 0.8rem;">
                                <button class="btn btn-outline-primary" type="button" id="copyUrlBtn" 
                                        onclick="copyProfileUrl()" title="Copy link">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                                <a href="@Model.PublicProfileUrl" target="_blank" class="btn btn-outline-secondary" 
                                   title="Open profile">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </div>

                            <!-- QR Code Section -->
                            <div class="text-center">
                                <div id="qrCodeContainer" class="mb-2"></div>
                                <button class="btn btn-sm btn-outline-primary" onclick="downloadQRCode()" id="downloadQrBtn">
                                    <i class="bi bi-download me-1"></i>Download QR Code
                                </button>
                            </div>

                            <!-- Copy Success Message -->
                            <div id="copySuccessMsg" class="alert alert-success py-1 px-2 mt-2 mb-0 d-none" 
                                 style="font-size: 0.8rem;">
                                <i class="bi bi-check-circle me-1"></i>Link copied to clipboard!
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Applications -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2" style="color: var(--primary-color);"></i>Recent Applications
                    </h5>
                    <a asp-controller="JobApplications" asp-action="MyApplications" class="btn btn-sm btn-outline-primary">
                        View All
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentApplications.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Position</th>
                                        <th>Company</th>
                                        <th>Applied</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model.RecentApplications)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@app.JobVacancyId"
                                                   class="fw-semibold text-decoration-none">
                                                    @(!string.IsNullOrWhiteSpace(app.JobTitle) ? app.JobTitle : "Unknown Job")
                                                </a>
                                            </td>
                                            <td class="text-muted">@(!string.IsNullOrWhiteSpace(app.CompanyName) ? app.CompanyName : "Unknown")</td>
                                            <td><small>@app.ApplyDate.ToString("MMM dd")</small></td>
                                            <td>
                                                <span class="badge @ApplicationStatusOptions.GetStatusBadgeClass(app.Status ?? "Pending")">
                                                    @(!string.IsNullOrWhiteSpace(app.Status) ? app.Status : "Pending")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state py-5">
                            <i class="bi bi-inbox"></i>
                            <h5>No applications yet</h5>
                            <p>Start applying to jobs to track your progress here.</p>
                            <a asp-controller="JobVacancies" asp-action="Index" class="btn btn-primary">
                                <i class="bi bi-search me-1"></i>Browse Jobs
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Saved Jobs Section -->
    @if (Model.RecentBookmarks.Any())
    {
        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-bookmark me-2" style="color: var(--primary-color);"></i>Saved Jobs
                </h5>
                <a asp-action="Bookmarks" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var bookmark in Model.RecentBookmarks)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card job-card h-100">
                                <div class="card-body">
                                    <h6 class="mb-1">
                                        <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@bookmark.JobVacancyId" 
                                           class="text-decoration-none">
                                            @(!string.IsNullOrWhiteSpace(bookmark.JobTitle) ? bookmark.JobTitle : "Unknown Job")
                                        </a>
                                    </h6>
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-building me-1"></i>
                                        @(!string.IsNullOrWhiteSpace(bookmark.CompanyName) ? bookmark.CompanyName : "Unknown Company")
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="bi bi-geo-alt me-1"></i>
                                            @(!string.IsNullOrWhiteSpace(bookmark.Location) ? bookmark.Location : "Not specified")
                                        </small>
                                        <span class="badge @((bookmark.Status ?? "Unknown") == "Open" ? "bg-success" : "bg-secondary")">
                                            @(!string.IsNullOrWhiteSpace(bookmark.Status) ? bookmark.Status : "Unknown")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <!-- QR Code Generation Library - qrcodejs (more reliable CDN) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <script>
        // Generate QR Code on page load
        document.addEventListener('DOMContentLoaded', function() {
            const publicUrl = document.getElementById('publicProfileUrl');
            const container = document.getElementById('qrCodeContainer');
            
            if (publicUrl && publicUrl.value && container) {
                console.log('Generating QR code for URL:', publicUrl.value);
                generateQRCode(publicUrl.value);
            } else {
                console.log('QR code elements not found or URL empty');
            }
        });

        // Generate QR Code using qrcodejs library
        function generateQRCode(url) {
            const container = document.getElementById('qrCodeContainer');
            if (!container) {
                console.error('QR container not found');
                return;
            }

            // Clear any existing QR code
            container.innerHTML = '';

            try {
                // Generate QR code using qrcodejs library
                new QRCode(container, {
                    text: url,
                    width: 150,
                    height: 150,
                    colorDark: '#1e3a5f',
                    colorLight: '#ffffff',
                    correctLevel: QRCode.CorrectLevel.M
                });
                
                // Add ID to the generated canvas for download functionality
                setTimeout(function() {
                    const canvas = container.querySelector('canvas');
                    if (canvas) {
                        canvas.id = 'qrCodeCanvas';
                    }
                }, 100);
                
                console.log('QR code generated successfully');
            } catch (error) {
                console.error('QR Code generation error:', error);
                container.innerHTML = '<p class="text-danger small">Failed to generate QR code</p>';
            }
        }

        // Copy public profile URL to clipboard
        function copyProfileUrl() {
            const urlInput = document.getElementById('publicProfileUrl');
            const successMsg = document.getElementById('copySuccessMsg');
            const copyBtn = document.getElementById('copyUrlBtn');

            if (!urlInput) return;

            // Use modern clipboard API
            navigator.clipboard.writeText(urlInput.value).then(function() {
                // Show success feedback
                successMsg.classList.remove('d-none');
                copyBtn.innerHTML = '<i class="bi bi-check"></i>';
                copyBtn.classList.remove('btn-outline-primary');
                copyBtn.classList.add('btn-success');

                // Reset after 2 seconds
                setTimeout(function() {
                    successMsg.classList.add('d-none');
                    copyBtn.innerHTML = '<i class="bi bi-clipboard"></i>';
                    copyBtn.classList.remove('btn-success');
                    copyBtn.classList.add('btn-outline-primary');
                }, 2000);
            }).catch(function(err) {
                // Fallback for older browsers
                urlInput.select();
                document.execCommand('copy');
                
                successMsg.classList.remove('d-none');
                setTimeout(function() {
                    successMsg.classList.add('d-none');
                }, 2000);
            });
        }

        // Download QR Code as PNG image
        function downloadQRCode() {
            const container = document.getElementById('qrCodeContainer');
            if (!container) {
                alert('QR code container not found');
                return;
            }

            // qrcodejs generates both canvas and img - try canvas first, then img
            let canvas = container.querySelector('canvas');
            let imgSrc = null;

            if (canvas) {
                imgSrc = canvas.toDataURL('image/png');
            } else {
                // Fallback to img element
                const img = container.querySelector('img');
                if (img) {
                    imgSrc = img.src;
                }
            }

            if (!imgSrc) {
                alert('QR code not generated yet');
                return;
            }

            // Create download link
            const link = document.createElement('a');
            link.download = 'my-profile-qrcode.png';
            link.href = imgSrc;
            
            // Trigger download
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Show feedback
            const downloadBtn = document.getElementById('downloadQrBtn');
            const originalHtml = downloadBtn.innerHTML;
            downloadBtn.innerHTML = '<i class="bi bi-check me-1"></i>Downloaded!';
            downloadBtn.classList.remove('btn-outline-primary');
            downloadBtn.classList.add('btn-success');

            setTimeout(function() {
                downloadBtn.innerHTML = originalHtml;
                downloadBtn.classList.remove('btn-success');
                downloadBtn.classList.add('btn-outline-primary');
            }, 2000);
        }
    </script>

    <style>
        .share-profile-section {
            padding: 0.5rem 0;
        }

        #qrCodeContainer {
            display: inline-block;
            padding: 0.5rem;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        #qrCodeCanvas {
            display: block;
        }
    </style>
}
