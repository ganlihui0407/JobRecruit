@model List<ApplicationDocumentViewModel>
@{
    ViewData["Title"] = "Applicant Documents";
    var applicantName = ViewBag.ApplicantName as string;
    var jobTitle = ViewBag.JobTitle as string;
    var applicationId = ViewBag.ApplicationId;
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/EmployerProfiles/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/JobVacancies">My Jobs</a></li>
            <li class="breadcrumb-item"><a href="/JobApplications/Received">Applications</a></li>
            <li class="breadcrumb-item active">Documents</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-file-earmark-text me-2"></i>Applicant Documents
            </h1>
            <p class="text-muted mb-0">
                <strong>@applicantName</strong> for <strong>@jobTitle</strong>
            </p>
        </div>
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-folder2-open display-1 text-muted"></i>
                <h4 class="mt-3">No Documents</h4>
                <p class="text-muted">This applicant has not uploaded any documents.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-files me-2"></i>@Model.Count Document(s)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;"></th>
                                <th>File Name</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                                <th style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        <i class="bi @doc.FileIcon fs-4"></i>
                                    </td>
                                    <td>
                                        <strong>@doc.FileName</strong>
                                        @if (!string.IsNullOrEmpty(doc.OriginalFileName) && doc.OriginalFileName != doc.FileName)
                                        {
                                            <br>
                                            <small class="text-muted">Original: @doc.OriginalFileName</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@doc.FileSizeDisplay</span>
                                    </td>
                                    <td>
                                        <span title="@doc.UploadedAt.ToString("yyyy-MM-dd HH:mm:ss")">
                                            @doc.UploadedAt.ToString("MMM dd, yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            @if (doc.ContentType?.StartsWith("image/") == true || doc.ContentType == "application/pdf")
                                            {
                                                <a href="/Files/View/@doc.ApplicationDocumentId" target="_blank" 
                                                   class="btn btn-outline-primary" title="View">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            }
                                            <a href="@doc.DownloadUrl" class="btn btn-outline-success" title="Download">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3 text-muted small">
            <i class="bi bi-info-circle me-1"></i>
            Click on a document to view or download. PDF and image files can be previewed in browser.
        </div>
    }
</div>

