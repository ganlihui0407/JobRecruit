@model List<ResumeSkillViewModel>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-star display-4 text-muted"></i>
        <p class="text-muted mt-2">No skills added yet.</p>
        <p class="text-muted small">Add your technical and soft skills to highlight your expertise.</p>
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-2">
        @foreach (var item in Model)
        {
            <div class="skill-tag d-inline-flex align-items-center bg-light rounded-pill px-3 py-2">
                <span class="me-2">
                    <strong>@item.SkillName</strong>
                    <small class="text-muted">(@item.SkillLevel)</small>
                </span>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-link btn-sm p-0 text-primary btn-edit-skill" data-id="@item.ResumeSkillId" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-link btn-sm p-0 text-danger ms-2 btn-delete-skill" data-id="@item.ResumeSkillId" title="Delete">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        }
    </div>

    <hr class="my-4">

    <h6 class="mb-3">Skills by Proficiency</h6>
    <div class="row g-3">
        @{
            var skillsByLevel = Model.GroupBy(s => s.SkillLevel).OrderByDescending(g => GetLevelOrder(g.Key));
        }
        @foreach (var group in skillsByLevel)
        {
            <div class="col-md-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-header bg-@GetLevelColor(group.Key)-subtle py-2">
                        <small class="fw-bold text-@GetLevelColor(group.Key)">@group.Key</small>
                    </div>
                    <div class="card-body py-2">
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var skill in group)
                            {
                                <li><i class="bi bi-check text-success me-1"></i>@skill.SkillName</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
}

@functions {
    int GetLevelOrder(string level)
    {
        return level switch
        {
            "Expert" => 4,
            "Advanced" => 3,
            "Intermediate" => 2,
            "Beginner" => 1,
            _ => 0
        };
    }

    string GetLevelColor(string level)
    {
        return level switch
        {
            "Expert" => "success",
            "Advanced" => "primary",
            "Intermediate" => "info",
            "Beginner" => "warning",
            _ => "secondary"
        };
    }
}

