@model ResumeSnapshotViewModel
@{
    ViewData["Title"] = Model.FullName + " - Resume";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/resume.css" asp-append-version="true">
    <style>
        body {
            background: #f8f9fa;
            padding: 20px 0;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Action Bar -->
        <div class="no-print text-center mb-4">
            <a href="/Resume" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left me-2"></i>Back to Editor
            </a>
            <a asp-controller="Resumes" asp-action="MyResumePdf" class="btn btn-primary me-2">
                <i class="bi bi-file-pdf me-2"></i>Download PDF
            </a>
            <a href="/Resume/DownloadPdf" class="btn btn-outline-primary me-2" target="_blank">
                <i class="bi bi-printer me-2"></i>Print-Ready Version
            </a>
            <button class="btn btn-outline-secondary" onclick="window.print()">
                <i class="bi bi-printer me-2"></i>Print
            </button>
        </div>

        <!-- Resume Content -->
        <div class="resume-wrapper">
            @await Html.PartialAsync("_ResumeTemplate", Model)
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
