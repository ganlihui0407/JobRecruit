@model List<ResumeEducationViewModel>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-mortarboard display-4 text-muted"></i>
        <p class="text-muted mt-2">No education records added yet.</p>
        <p class="text-muted small">Add your educational background to strengthen your resume.</p>
    </div>
}
else
{
    <div class="list-group list-group-flush">
        @foreach (var item in Model)
        {
            <div class="list-group-item px-0">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center mb-1">
                            <i class="bi bi-mortarboard text-primary me-2"></i>
                            <h6 class="mb-0 fw-bold">@item.Qualification</h6>
                        </div>
                        <p class="mb-1 text-muted">@item.SchoolName</p>
                        @if (!string.IsNullOrEmpty(item.FieldOfStudy))
                        {
                            <p class="mb-1 small"><i class="bi bi-book me-1"></i>@item.FieldOfStudy</p>
                        }
                        <small class="text-muted">
                            <i class="bi bi-calendar me-1"></i>
                            @item.StartYear - @(item.EndYear.HasValue ? item.EndYear.ToString() : "Present")
                        </small>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-primary btn-edit-education" data-id="@item.ResumeEducationId" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-delete-education" data-id="@item.ResumeEducationId" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

