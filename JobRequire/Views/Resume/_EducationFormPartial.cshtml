@model ResumeEducationViewModel

<form asp-action="SaveEducation" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ResumeEducationId" />
    <input type="hidden" asp-for="JobSeekerProfileId" />

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="SchoolName" class="form-label">School/University <span class="text-danger">*</span></label>
            <input asp-for="SchoolName" class="form-control" placeholder="e.g., Harvard University" />
            <span asp-validation-for="SchoolName" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Qualification" class="form-label">Qualification/Degree <span class="text-danger">*</span></label>
            <select asp-for="Qualification" class="form-select">
                <option value="">Select qualification...</option>
                @foreach (var option in ResumeOptions.GetQualifications())
                {
                    <option value="@option" selected="@(Model.Qualification == option)">@option</option>
                }
            </select>
            <span asp-validation-for="Qualification" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="FieldOfStudy" class="form-label">Field of Study</label>
            <input asp-for="FieldOfStudy" class="form-control" placeholder="e.g., Computer Science" />
            <span asp-validation-for="FieldOfStudy" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="StartYear" class="form-label">Start Year <span class="text-danger">*</span></label>
            <select asp-for="StartYear" class="form-select">
                @for (int year = DateTime.Now.Year; year >= 1970; year--)
                {
                    <option value="@year" selected="@(Model.StartYear == year)">@year</option>
                }
            </select>
            <span asp-validation-for="StartYear" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="EndYear" class="form-label">End Year</label>
            <select asp-for="EndYear" class="form-select" id="endYearSelect" disabled="@Model.IsCurrentlyStudying">
                <option value="">Select year...</option>
                @for (int year = DateTime.Now.Year + 5; year >= 1970; year--)
                {
                    <option value="@year" selected="@(Model.EndYear == year)">@year</option>
                }
            </select>
            <span asp-validation-for="EndYear" class="text-danger"></span>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IsCurrentlyStudying" class="form-check-input" type="checkbox" id="isCurrentlyStudying" />
                <label class="form-check-label" for="isCurrentlyStudying">
                    Currently studying
                </label>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-2"></i>Save Education
        </button>
    </div>
</form>

<script>
    $(document).ready(function() {
        $('#isCurrentlyStudying').on('change', function() {
            $('#endYearSelect').prop('disabled', this.checked);
            if (this.checked) {
                $('#endYearSelect').val('');
            }
        });
    });
</script>

