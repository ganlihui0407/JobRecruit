@model PublicProfileViewModel
@{
    ViewData["Title"] = $"{Model.FullName} - Public Profile";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - JobRecruit</title>
    <meta name="description" content="View @Model.FullName's professional profile and resume on JobRecruit">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/resume.css">
    <style>
        :root {
            --primary-color: #3b82f6;
            --primary-dark: #1e3a5f;
            --text-primary: #1f2937;
            --text-secondary: #6b7280;
            --bg-light: #f8fafc;
            --border-color: #e5e7eb;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        .public-profile-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .profile-header-card {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            border-radius: 16px 16px 0 0;
            padding: 2rem;
            color: white;
            text-align: center;
        }

        .profile-avatar {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid rgba(255,255,255,0.3);
            margin-bottom: 1rem;
            background: white;
        }

        .profile-avatar-placeholder {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            border: 4px solid rgba(255,255,255,0.3);
        }

        .profile-avatar-placeholder i {
            font-size: 4rem;
            color: rgba(255,255,255,0.7);
        }

        .profile-name {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .profile-contact {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 1.5rem;
            font-size: 0.95rem;
            opacity: 0.9;
        }

        .profile-contact-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .profile-stats {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255,255,255,0.2);
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .stat-label {
            font-size: 0.8rem;
            opacity: 0.8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .resume-content-card {
            background: white;
            border-radius: 0 0 16px 16px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .resume-wrapper {
            max-width: 100%;
        }

        .resume-card {
            box-shadow: none;
            border-radius: 0;
        }

        .powered-by {
            text-align: center;
            padding: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .powered-by a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
        }

        .powered-by a:hover {
            text-decoration: underline;
        }

        .no-content-message {
            text-align: center;
            padding: 3rem;
            color: var(--text-secondary);
        }

        .no-content-message i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .public-profile-container {
                max-width: 100%;
            }

            .profile-header-card {
                border-radius: 0;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .resume-content-card {
                border-radius: 0;
                box-shadow: none;
            }

            .powered-by {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="public-profile-container">
        <!-- Profile Header -->
        <div class="profile-header-card">
            @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
            {
                <img src="@Model.ProfilePhoto" alt="@Model.FullName" class="profile-avatar" />
            }
            else
            {
                <div class="profile-avatar-placeholder">
                    <i class="bi bi-person"></i>
                </div>
            }
            
            <h1 class="profile-name">@Model.FullName</h1>
            
            <div class="profile-contact">
                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                {
                    <span class="profile-contact-item">
                        <i class="bi bi-phone"></i>
                        <span>@Model.PhoneNumber</span>
                    </span>
                }
            </div>

            <div class="profile-stats">
                <div class="stat-item">
                    <div class="stat-value">@Model.TotalExperience</div>
                    <div class="stat-label">Experience</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">@Model.TotalEducation</div>
                    <div class="stat-label">Education</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">@Model.TotalSkills</div>
                    <div class="stat-label">Skills</div>
                </div>
            </div>
        </div>

        <!-- Resume Content -->
        <div class="resume-content-card">
            @if (Model.Resume != null && 
                (!string.IsNullOrEmpty(Model.Resume.Summary) || 
                 Model.Resume.Experience.Count > 0 || 
                 Model.Resume.Education.Count > 0 || 
                 Model.Resume.Skills.Count > 0))
            {
                <div class="resume-wrapper">
                    @await Html.PartialAsync("~/Views/Resume/_ResumeTemplate.cshtml", Model.Resume)
                </div>
            }
            else
            {
                <div class="no-content-message">
                    <i class="bi bi-file-earmark-text"></i>
                    <h5>No resume content available</h5>
                    <p>This profile doesn't have any resume information yet.</p>
                </div>
            }
        </div>

        <!-- Footer -->
        <div class="powered-by">
            <i class="bi bi-briefcase me-1"></i>
            Powered by <a href="/" target="_blank">JobRecruit</a>
            <span class="mx-2">•</span>
            <span>View generated on @Model.GeneratedAt.ToString("MMMM dd, yyyy")</span>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>



