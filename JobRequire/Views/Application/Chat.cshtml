@model JobRequire.ViewModels.ApplicationChatViewModel
@{
    ViewData["Title"] = "Application Chat";
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="ChatInbox" asp-action="Inbox">Chat Inbox</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chat</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-chat-dots me-2" style="color: var(--primary-color);"></i>Application Chat
            </h2>
            <p class="text-secondary mb-0">
                @Model.JobTitle at @Model.CompanyName
            </p>
        </div>
        @if (!string.IsNullOrEmpty(Model.BackUrl))
        {
            <a href="@Model.BackUrl" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to Application
            </a>
        }
    </div>

    <div class="row">
        <!-- Chat Panel -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-chat-dots me-2" style="color: var(--primary-color);"></i>Messages
                    </h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="refreshChat()" title="Refresh messages">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <div class="card-body p-0">
                    <!-- Chat Status Alert -->
                    <div id="chatStatusAlert" class="d-none"></div>
                    
                    <!-- Chat Loading -->
                    <div id="chatLoading" class="text-center py-5">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">Loading chat...</p>
                    </div>
                    
                    <!-- Chat Unavailable -->
                    <div id="chatUnavailable" class="d-none text-center py-5 px-3">
                        <i class="bi bi-chat-left-dots text-muted display-4 d-block mb-3"></i>
                        <p class="text-muted mb-0">Chat will be available once the application status is updated from Pending.</p>
                    </div>
                    
                    <!-- Chat Messages Container -->
                    <div id="chatMessagesContainer" class="d-none">
                        <div id="chatMessages" class="p-3" style="height: 450px; overflow-y: auto;">
                            <!-- Messages will be loaded here -->
                        </div>
                        
                        <!-- Read-only notice -->
                        <div id="chatReadOnlyNotice" class="d-none alert alert-secondary m-3 mb-0">
                            <i class="bi bi-lock me-2"></i>
                            <small>This chat is read-only because the application has been rejected or withdrawn.</small>
                        </div>
                        
                        <!-- Chat Input -->
                        <div id="chatInputContainer" class="border-top p-3">
                            <form id="chatForm" onsubmit="sendMessage(event)">
                                <div class="input-group">
                                    <input type="text" id="chatInput" class="form-control" 
                                           placeholder="Type your message..." maxlength="2000"
                                           autocomplete="off" />
                                    <button type="submit" class="btn btn-primary" id="sendButton">
                                        <i class="bi bi-send"></i>
                                    </button>
                                </div>
                                <small class="text-muted mt-1 d-block">
                                    <span id="charCount">0</span>/2000 characters
                                </small>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Application Info Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2" style="color: var(--primary-color);"></i>Application Info
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted d-block">Position</small>
                        <strong>@Model.JobTitle</strong>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Company</small>
                        <strong>@Model.CompanyName</strong>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Applicant</small>
                        <strong>@Model.ApplicantName</strong>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Applied On</small>
                        <strong>@Model.ApplyDate.ToString("MMM dd, yyyy")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block">Status</small>
                        <span class="badge @GetStatusBadgeClass(Model.ApplicationStatus) fs-6">
                            @Model.ApplicationStatus
                        </span>
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning me-2" style="color: var(--primary-color);"></i>Quick Links
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (!string.IsNullOrEmpty(Model.BackUrl))
                        {
                            <a href="@Model.BackUrl" class="btn btn-outline-primary">
                                <i class="bi bi-file-earmark-text me-2"></i>View Application Details
                            </a>
                        }
                        <a asp-controller="ChatInbox" asp-action="Inbox" class="btn btn-outline-secondary">
                            <i class="bi bi-inbox me-2"></i>Chat Inbox
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #chatMessages {
        background-color: #f8f9fa;
    }
    .chat-message {
        margin-bottom: 12px;
        display: flex;
        flex-direction: column;
    }
    .chat-message.sent {
        align-items: flex-end;
    }
    .chat-message.received {
        align-items: flex-start;
    }
    .chat-message.system {
        align-items: center;
    }
    .chat-bubble {
        max-width: 80%;
        padding: 10px 14px;
        border-radius: 16px;
        word-wrap: break-word;
    }
    .chat-message.sent .chat-bubble {
        background-color: #1e3a5f;
        color: white;
        border-bottom-right-radius: 4px;
    }
    .chat-message.received .chat-bubble {
        background-color: white;
        color: #333;
        border: 1px solid #e0e0e0;
        border-bottom-left-radius: 4px;
    }
    .chat-message.system .chat-bubble {
        background-color: #e9ecef;
        color: #6c757d;
        font-size: 0.85em;
        font-style: italic;
        max-width: 90%;
        text-align: center;
    }
    .chat-sender {
        font-size: 0.75em;
        color: #6c757d;
        margin-bottom: 2px;
    }
    .chat-time {
        font-size: 0.7em;
        color: #999;
        margin-top: 4px;
    }
    .chat-message.sent .chat-time {
        text-align: right;
    }
</style>

<script>
    var chatJobApplicationId = @Model.JobApplicationId;
    var chatIsReadOnly = false;
    var chatIsAvailable = false;

    document.addEventListener('DOMContentLoaded', function() {
        loadChat();
        
        // Character counter
        var chatInput = document.getElementById('chatInput');
        var charCount = document.getElementById('charCount');
        if (chatInput && charCount) {
            chatInput.addEventListener('input', function() {
                charCount.textContent = this.value.length;
            });
        }
    });

    function loadChat() {
        showLoading();
        
        fetch('/api/Chat/' + chatJobApplicationId, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            hideLoading();
            
            if (!data.isAvailable) {
                showUnavailable();
                return;
            }
            
            chatIsAvailable = true;
            chatIsReadOnly = data.isReadOnly;
            
            showChatContainer();
            renderMessages(data.messages);
            
            if (data.isReadOnly) {
                showReadOnlyNotice();
                disableInput();
            }
        })
        .catch(error => {
            console.error('Error loading chat:', error);
            hideLoading();
            showError('Failed to load chat. Please try again.');
        });
    }

    function refreshChat() {
        loadChat();
    }

    function sendMessage(event) {
        event.preventDefault();
        
        if (chatIsReadOnly || !chatIsAvailable) {
            return;
        }
        
        var input = document.getElementById('chatInput');
        var message = input.value.trim();
        
        if (!message) {
            return;
        }
        
        var sendButton = document.getElementById('sendButton');
        sendButton.disabled = true;
        
        fetch('/api/Chat/' + chatJobApplicationId, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ message: message })
        })
        .then(response => {
            if (!response.ok) {
                return response.json().then(err => { throw new Error(err.error || 'Failed to send message'); });
            }
            return response.json();
        })
        .then(data => {
            input.value = '';
            document.getElementById('charCount').textContent = '0';
            appendMessage(data);
            scrollToBottom();
        })
        .catch(error => {
            console.error('Error sending message:', error);
            alert(error.message || 'Failed to send message. Please try again.');
        })
        .finally(() => {
            sendButton.disabled = false;
            input.focus();
        });
    }

    function renderMessages(messages) {
        var container = document.getElementById('chatMessages');
        container.innerHTML = '';
        
        if (messages.length === 0) {
            container.innerHTML = '<p class="text-center text-muted py-3">No messages yet. Start the conversation!</p>';
            return;
        }
        
        messages.forEach(function(msg) {
            appendMessage(msg);
        });
        
        scrollToBottom();
    }

    function appendMessage(msg) {
        var container = document.getElementById('chatMessages');
        
        // Remove "no messages" placeholder if present
        var placeholder = container.querySelector('.text-center.text-muted');
        if (placeholder) {
            placeholder.remove();
        }
        
        var messageClass = 'chat-message';
        if (msg.senderRole === 'System') {
            messageClass += ' system';
        } else if (msg.isCurrentUser) {
            messageClass += ' sent';
        } else {
            messageClass += ' received';
        }
        
        var senderLabel = '';
        if (msg.senderRole !== 'System' && !msg.isCurrentUser) {
            senderLabel = '<div class="chat-sender">' + escapeHtml(msg.senderRole) + '</div>';
        }
        
        var timeStr = formatTime(msg.createdAt);
        
        var html = '<div class="' + messageClass + '">' +
                   senderLabel +
                   '<div class="chat-bubble">' + escapeHtml(msg.message) + '</div>' +
                   '<div class="chat-time">' + timeStr + '</div>' +
                   '</div>';
        
        container.insertAdjacentHTML('beforeend', html);
    }

    function formatTime(dateString) {
        var date = new Date(dateString);
        var now = new Date();
        var diff = now - date;
        
        // If less than 24 hours, show time only
        if (diff < 86400000) {
            return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
        // If less than 7 days, show day and time
        if (diff < 604800000) {
            return date.toLocaleDateString([], { weekday: 'short' }) + ' ' + 
                   date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
        // Otherwise show full date
        return date.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' ' +
               date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function scrollToBottom() {
        var container = document.getElementById('chatMessages');
        container.scrollTop = container.scrollHeight;
    }

    function showLoading() {
        document.getElementById('chatLoading').classList.remove('d-none');
        document.getElementById('chatUnavailable').classList.add('d-none');
        document.getElementById('chatMessagesContainer').classList.add('d-none');
    }

    function hideLoading() {
        document.getElementById('chatLoading').classList.add('d-none');
    }

    function showUnavailable() {
        document.getElementById('chatUnavailable').classList.remove('d-none');
        document.getElementById('chatMessagesContainer').classList.add('d-none');
    }

    function showChatContainer() {
        document.getElementById('chatMessagesContainer').classList.remove('d-none');
        document.getElementById('chatUnavailable').classList.add('d-none');
    }

    function showReadOnlyNotice() {
        document.getElementById('chatReadOnlyNotice').classList.remove('d-none');
    }

    function disableInput() {
        document.getElementById('chatInputContainer').classList.add('d-none');
    }

    function showError(message) {
        var alert = document.getElementById('chatStatusAlert');
        alert.className = 'alert alert-danger m-3';
        alert.textContent = message;
    }
</script>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "bg-secondary",
            "reviewed" => "bg-info",
            "shortlisted" => "bg-primary",
            "interview" => "bg-warning text-dark",
            "offered" => "bg-success",
            "hired" => "bg-success",
            "rejected" => "bg-danger",
            "withdrawn" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}





