@{
    ViewData["Title"] = "Password Reset";
}

<div class="py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-envelope-check display-1 text-success"></i>
                    </div>
                    <h2 class="fw-bold mb-3">Check Your Email</h2>
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success text-start mb-4">
                            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                        </div>
                    }

                    <p class="text-secondary mb-4">
                        If an account with that email exists, a verification code has been sent.
                    </p>
                    <div class="alert alert-info text-start">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>The verification code will expire in 10 minutes.</strong>
                    </div>
                    <p class="text-secondary mt-3">
                        Please check your email inbox (and spam folder) for the verification code.
                    </p>
                    
                    <div class="mt-4">
                        <a asp-action="ForgotPassword" class="btn btn-outline-primary me-2">
                            <i class="bi bi-arrow-left me-2"></i>Try Again
                        </a>
                        <a asp-action="Login" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

