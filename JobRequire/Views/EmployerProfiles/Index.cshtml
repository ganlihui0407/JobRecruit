@model EmployerProfileListViewModel
@{
    ViewData["Title"] = "Companies";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Companies</h1>
            <p class="text-secondary mb-0">Discover employers and their job opportunities</p>
        </div>
        @if (User.IsInRole("Employer"))
        {
            <a asp-action="MyProfile" class="btn btn-primary">
                <i class="bi bi-building me-2"></i>My Company Profile
            </a>
        }
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm" 
                               placeholder="Search companies..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="industryFilter" class="form-select">
                        <option value="">All Industries</option>
                        @foreach (var industry in Model.Industries)
                        {
                            <option value="@industry" selected="@(Model.IndustryFilter == industry)">@industry</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    @if (Model.Profiles.Any())
    {
        <div class="row g-4">
            @foreach (var profile in Model.Profiles)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                @if (!string.IsNullOrEmpty(profile.CompanyLogo))
                                {
                                    <img src="@profile.CompanyLogo" alt="@profile.CompanyName" 
                                         class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center me-3" 
                                         style="width: 60px; height: 60px;">
                                        <i class="bi bi-building text-primary fs-4"></i>
                                    </div>
                                }
                                <div>
                                    <h5 class="mb-1">
                                        <a asp-action="Details" asp-route-id="@profile.EmployerProfileId" class="text-decoration-none">
                                            @profile.CompanyName
                                        </a>
                                    </h5>
                                    @if (!string.IsNullOrEmpty(profile.Industry))
                                    {
                                        <span class="badge bg-secondary">@profile.Industry</span>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(profile.CompanyDescription))
                            {
                                <p class="text-secondary text-truncate-2 mb-3">@profile.CompanyDescription</p>
                            }
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary">
                                    <i class="bi bi-briefcase me-1"></i>@profile.JobVacanciesCount open positions
                                </span>
                                <a asp-action="Details" asp-route-id="@profile.EmployerProfileId" class="btn btn-outline-primary btn-sm">
                                    View <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-industryFilter="@Model.IndustryFilter">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageNumber="@i"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-industryFilter="@Model.IndustryFilter">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-industryFilter="@Model.IndustryFilter">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-building display-1 text-secondary"></i>
            <h4 class="mt-3">No companies found</h4>
            <p class="text-secondary">Try adjusting your search criteria</p>
        </div>
    }
</div>

