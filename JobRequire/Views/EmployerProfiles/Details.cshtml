@model EmployerProfileViewModel
@{
    ViewData["Title"] = Model.CompanyName;
}

<div class="py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Companies</a></li>
            <li class="breadcrumb-item active">@Model.CompanyName</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-4">
                        @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                        {
                            <img src="@Model.CompanyLogo" alt="@Model.CompanyName" 
                                 class="rounded me-4" style="width: 100px; height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center me-4" 
                                 style="width: 100px; height: 100px;">
                                <i class="bi bi-building text-primary display-5"></i>
                            </div>
                        }
                        <div>
                            <h1 class="fw-bold mb-2">@Model.CompanyName</h1>
                            @if (!string.IsNullOrEmpty(Model.Industry))
                            {
                                <span class="badge bg-primary fs-6 me-2">@Model.Industry</span>
                            }
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-briefcase me-1"></i>@Model.JobVacanciesCount Open Positions
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CompanyDescription))
                    {
                        <h5 class="mb-3">About Us</h5>
                        <p class="text-secondary">@Model.CompanyDescription</p>
                    }
                </div>
            </div>

            <!-- Job Listings -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-briefcase me-2"></i>Open Positions</h5>
                </div>
                <div class="card-body">
                    <p class="text-secondary">
                        <a asp-controller="JobVacancies" asp-action="Index" asp-route-searchTerm="@Model.CompanyName">
                            View all @Model.JobVacanciesCount open positions at @Model.CompanyName
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Company Information</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        @if (!string.IsNullOrEmpty(Model.Industry))
                        {
                            <li class="mb-3">
                                <i class="bi bi-tag text-primary me-2"></i>
                                <strong>Industry:</strong> @Model.Industry
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.CompanyAddress))
                        {
                            <li class="mb-3">
                                <i class="bi bi-geo-alt text-primary me-2"></i>
                                <strong>Address:</strong><br />
                                <span class="ms-4">@Model.CompanyAddress</span>
                            </li>
                        }
                        <li class="mb-3">
                            <i class="bi bi-briefcase text-primary me-2"></i>
                            <strong>Open Positions:</strong> @Model.JobVacanciesCount
                        </li>
                    </ul>

                    @if (User.IsInRole("Employer") || User.IsInRole("Admin"))
                    {
                        <hr />
                        <div class="d-grid gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.EmployerProfileId" class="btn btn-outline-primary">
                                <i class="bi bi-pencil me-2"></i>Edit Profile
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

