@model EmployerDashboardViewModel
@{
    ViewData["Title"] = "Employer Dashboard";
}

<div class="py-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="page-title mb-1">Employer Dashboard</h1>
            <p class="helper-text mb-0">Manage your job postings and review applicants</p>
        </div>
        <a asp-controller="JobVacancies" asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-lg me-2"></i>Post a Job
        </a>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>
                    <div class="stat-value">@Model.TotalJobs</div>
                    <div class="stat-label">Total Jobs</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100" style="border-left: 4px solid var(--success-color);">
                <div class="card-body">
                    <div class="stat-icon" style="color: var(--success-color);">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-value">@Model.OpenJobs</div>
                    <div class="stat-label">Active Jobs</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100" style="border-left: 4px solid var(--info-color);">
                <div class="card-body">
                    <div class="stat-icon" style="color: var(--info-color);">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                    <div class="stat-value">@Model.TotalApplications</div>
                    <div class="stat-label">Applications</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100" style="border-left: 4px solid var(--warning-color);">
                <div class="card-body">
                    <div class="stat-icon" style="color: var(--warning-color);">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div class="stat-value">@Model.PendingApplications</div>
                    <div class="stat-label">Pending Review</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Decision Data Row -->
    <div class="row g-4 mb-4">
        <!-- Applications by Status -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-pie-chart me-2" style="color: var(--primary-color);"></i>
                        Applications by Status
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.ApplicationsByStatus.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var status in Model.ApplicationsByStatus)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div class="d-flex align-items-center">
                                        <i class="bi @status.Icon me-2 text-muted"></i>
                                        <span>@status.Status</span>
                                    </div>
                                    <span class="badge @status.BadgeClass rounded-pill">@status.Count</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox display-4 d-block mb-2"></i>
                            <p class="mb-0">No applications yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Most Interested Jobs -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-fire me-2" style="color: #ff6b35;"></i>
                        🔥 Most Interested Jobs
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.MostInterestedJobs.Any(j => j.InterestedCount > 0))
                    {
                        <div class="list-group list-group-flush">
                            @{ var rank = 1; }
                            @foreach (var job in Model.MostInterestedJobs.Where(j => j.InterestedCount > 0))
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="d-flex align-items-start">
                                            <span class="badge bg-secondary rounded-pill me-2">@rank</span>
                                            <div>
                                                <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@job.JobVacancyId" 
                                                   class="fw-semibold text-decoration-none d-block">
                                                    @(job.JobTitle.Length > 25 ? job.JobTitle.Substring(0, 25) + "..." : job.JobTitle)
                                                </a>
                                                @if (job.IsPopular)
                                                {
                                                    <small class="text-warning"><i class="bi bi-star-fill me-1"></i>Popular Job</small>
                                                }
                                            </div>
                                        </div>
                                        <span class="badge bg-danger">
                                            <i class="bi bi-heart-fill me-1"></i>@job.InterestedCount
                                        </span>
                                    </div>
                                </div>
                                rank++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-heart display-4 d-block mb-2"></i>
                            <p class="mb-0">No interests recorded yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Jobs Posted Last 30 Days -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-check me-2" style="color: var(--primary-color);"></i>
                        Recent Activity
                    </h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="text-center py-3">
                        <div class="display-3 fw-bold" style="color: var(--primary-color);">@Model.JobsPostedLast30Days</div>
                        <p class="text-muted mb-3">Jobs posted in last 30 days</p>
                        <hr class="my-3" />
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="h4 mb-0 text-success">@Model.OpenJobs</div>
                                <small class="text-muted">Active</small>
                            </div>
                            <div class="col-6">
                                <div class="h4 mb-0 text-secondary">@Model.ClosedJobs</div>
                                <small class="text-muted">Closed</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-bar-chart me-2" style="color: var(--primary-color);"></i>
                        Applicants per Job
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="applicantsPerJobChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar3 me-2" style="color: var(--primary-color);"></i>
                        Jobs Posted Over Time
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="jobsPostedByMonthChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Job Postings List -->
    <div class="card">
        <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
            <div>
                <h5 class="mb-1">Your Job Postings</h5>
                <small class="text-muted">Click on a job to view applicants</small>
            </div>
            <a asp-controller="JobVacancies" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i>New Job
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.JobVacancies.Count == 0)
            {
                <div class="empty-state py-5">
                    <i class="bi bi-inbox"></i>
                    <h5>No job postings yet</h5>
                    <p>Create your first job posting to start receiving applications.</p>
                    <a asp-controller="JobVacancies" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Post Your First Job
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="min-width: 250px;">Job Title</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Published</th>
                                <th>Applications</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in Model.JobVacancies)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@job.JobVacancyId" 
                                           class="fw-semibold text-decoration-none">
                                            @job.JobTitle
                                        </a>
                                        <div class="small text-muted">
                                            <i class="bi bi-geo-alt me-1"></i>@job.Location
                                            @if (job.SalaryMin.HasValue || job.SalaryMax.HasValue)
                                            {
                                                <span class="ms-2">
                                                    <i class="bi bi-cash-stack me-1"></i>
                                                    @if (job.SalaryMin.HasValue && job.SalaryMax.HasValue)
                                                    {
                                                        <text>RM @job.SalaryMin.Value.ToString("N0") - RM @job.SalaryMax.Value.ToString("N0")</text>
                                                    }
                                                    else if (job.SalaryMin.HasValue)
                                                    {
                                                        <text>From RM @job.SalaryMin.Value.ToString("N0")</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Up to RM @job.SalaryMax.Value.ToString("N0")</text>
                                                    }
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td><span class="badge bg-secondary">@job.Category</span></td>
                                    <td>@job.JobType</td>
                                    <td>
                                        <span class="badge @(job.Status == "Open" ? "bg-success" : job.Status == "Closed" ? "bg-secondary" : "bg-warning")">
                                            @job.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small>@job.PublishDate.ToString("MMM dd, yyyy")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <span class="badge bg-primary">@job.TotalApplications total</span>
                                            @if (job.PendingApplications > 0)
                                            {
                                                <span class="badge bg-warning text-dark">@job.PendingApplications pending</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-controller="JobApplications" asp-action="Index" asp-route-jobVacancyId="@job.JobVacancyId" 
                                               class="btn btn-outline-primary" title="View Applicants">
                                                <i class="bi bi-people"></i>
                                            </a>
                                            @if (job.TotalApplications > 0)
                                            {
                                                <a asp-action="ExportApplicants" asp-route-jobVacancyId="@job.JobVacancyId" 
                                                   class="btn btn-outline-success" title="Export CSV">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                            }
                                            <a asp-controller="JobVacancies" asp-action="Details" asp-route-id="@job.JobVacancyId" 
                                               class="btn btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        // Chart color palette matching the warm wood-tone theme
        const chartColors = {
            primary: 'rgba(166, 124, 82, 0.8)',
            primaryBorder: 'rgba(166, 124, 82, 1)',
            success: 'rgba(91, 138, 114, 0.8)',
            successBorder: 'rgba(91, 138, 114, 1)'
        };

        // Applicants per Job Chart
        @if (Model.ApplicantPerJobChart.Count > 0)
        {
            <text>
            const applicantsPerJobCtx = document.getElementById('applicantsPerJobChart').getContext('2d');
            new Chart(applicantsPerJobCtx, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.ApplicantPerJobChart.Select(d => $"\"{d.JobTitle}\"")))],
                    datasets: [{
                        label: 'Applicants',
                        data: [@string.Join(",", Model.ApplicantPerJobChart.Select(d => d.ApplicantCount))],
                        backgroundColor: chartColors.primary,
                        borderColor: chartColors.primaryBorder,
                        borderWidth: 2,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            ticks: { maxRotation: 45, minRotation: 45 },
                            grid: { display: false }
                        }
                    }
                }
            });
            </text>
        }
        else
        {
            <text>
            document.getElementById('applicantsPerJobChart').parentElement.innerHTML = 
                '<div class="empty-state py-4"><i class="bi bi-bar-chart" style="font-size: 3rem;"></i><p class="text-muted mt-2 mb-0">No applications received yet</p></div>';
            </text>
        }

        // Jobs Posted by Month Chart
        @if (Model.JobsPostedByMonthChart.Count > 0)
        {
            <text>
            const jobsPostedByMonthCtx = document.getElementById('jobsPostedByMonthChart').getContext('2d');
            new Chart(jobsPostedByMonthCtx, {
                type: 'line',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.JobsPostedByMonthChart.Select(d => $"\"{d.Month}\"")))],
                    datasets: [{
                        label: 'Jobs Posted',
                        data: [@string.Join(",", Model.JobsPostedByMonthChart.Select(d => d.JobCount))],
                        backgroundColor: 'rgba(91, 138, 114, 0.1)',
                        borderColor: chartColors.successBorder,
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: chartColors.successBorder,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            ticks: { maxRotation: 45, minRotation: 45 },
                            grid: { display: false }
                        }
                    }
                }
            });
            </text>
        }
        else
        {
            <text>
            document.getElementById('jobsPostedByMonthChart').parentElement.innerHTML = 
                '<div class="empty-state py-4"><i class="bi bi-calendar3" style="font-size: 3rem;"></i><p class="text-muted mt-2 mb-0">No posting history yet</p></div>';
            </text>
        }
    </script>
}
